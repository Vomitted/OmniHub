bin/
obj/
.vs/
*.user

# Local agent/tool configuration. Machine-specific, not part of the app.
.claude/
.claude-flow/

# Packaged release output (uploaded to GitHub Releases, not committed).
dist/

# Generated code graph. 11 MB, rebuilt from the tree by `graphify update .` in seconds and
# with no API cost, so committing it would mean carrying a large artefact that is stale the
# moment anyone edits a file. The technical documents under technical/ are the part written
# by hand and are committed.
graphify-out/

# Obsidian: the repository root is used as a vault. Its window layout changes every time it is
# opened, so it is never worth committing even if the rest of the vault settings ever are.
**/.obsidian/workspace*.json
