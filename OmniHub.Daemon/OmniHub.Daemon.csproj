<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux half of OmniHub: the cooling loop, without the Windows application around it.

       It publishes self-contained, and that is the answer to "every popular distro". Depending
       on a system .NET runtime would have meant a different package name and a different version
       on every one of them, and on several it would have meant asking people to add a
       third-party repository first. A self-contained single file needs nothing but a kernel and
       glibc, so one build serves Debian, Ubuntu, Fedora, Arch, openSUSE and everything
       downstream of them, and packaging becomes a question of where to put the file rather than
       what to depend on.

       NOTE: no double hyphen anywhere in these comments. XML forbids it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>omnihub</AssemblyName>
    <RootNamespace>OmniHub.Daemon</RootNamespace>

    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Halves the published file at the cost of a little startup. Not trimmed, deliberately:
         trimming removes types that only reflection can see, System.Text.Json finds the profile
         and curve shapes by reflection, and the failure mode would be a config file silently
         deserialising to nothing on somebody's laptop. A larger download is a much cheaper
         mistake than a fan curve that quietly falls back to defaults. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Culture-invariant on purpose. Every number this program reads or writes is either a
         kernel sysfs attribute or a profile file, and both are machine formats: a decimal comma
         from a European locale would produce a duty cycle the kernel cannot parse back. It also
         drops the ICU dependency, which is one fewer thing to be missing on a minimal install. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniHub.Core\OmniHub.Core.csproj" />
  </ItemGroup>

</Project>
