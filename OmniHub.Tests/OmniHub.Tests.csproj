<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches OmniHub.Core. The template defaults to the newest installed runtime, which
         cannot reference a net8.0-windows assembly; the -windows suffix is required because
         Core depends on System.Management. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- For the WPF framework types only, ResourceDictionary and XamlReader, so the style layer
         can be constructed and checked rather than merely read as text. A style whose trigger
         names a property that does not exist, or a template that cannot be built, is not a
         compiler error: it throws when the dictionary is parsed, which until now meant when
         somebody opened the application.

         This is NOT a reference to OmniHub.App. The note on the ProjectReference below still
         stands, and the tests using these types create their own STA thread rather than letting
         one into the host. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core only, and for a sharper reason than the original note gave.
         The App project's build output IS the installed application: the desktop shortcut, the
         Start Menu entry and the OmniHub_AutoStart scheduled task all point at
         bin\Release\net8.0-windows\OmniHub.exe. Referencing it here makes "dotnet test" build
         that path, which fails outright whenever OmniHub is running, because the running process
         holds a lock on its own executable.

         Tests must not require the user to shut down their fan control first. Markup that
         declares a clr-namespace from OmniHub.App is therefore checked as text rather than
         parsed; ViewMarkupTests says which files that costs and why. -->
    <ProjectReference Include="..\OmniHub.Core\OmniHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
