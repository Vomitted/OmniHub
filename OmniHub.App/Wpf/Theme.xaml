<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         OmniHub theme: instrument panel, not a gaming skin.

         Colour VALUES no longer live here. They live in Wpf/Palettes/*.xaml, one file
         per theme, and ThemeManager swaps which one is merged. This file defines the
         brushes, fonts and geometry that every theme shares.

         Every brush below binds its Color with {DynamicResource}, never {StaticResource}.
         That is the whole mechanism behind live theme switching: a StaticResource is
         resolved once at load and baked in, so the app would need a restart; a
         DynamicResource keeps the lookup live, so swapping the palette re-tints every
         control in place.

         The rule the palettes are built around: COLOUR MEANS STATE. Green/amber/red
         belong to real readings and are applied at runtime from live values. Chrome
         stays neutral, so when something does go red it is the only red on screen.
         ============================================================ -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{DynamicResource PanelAltColor}"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="{DynamicResource PanelHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{DynamicResource TextFaintColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush2" Color="{DynamicResource AccentColor2}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{DynamicResource AccentDimColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{DynamicResource GoodColor}"/>
    <SolidColorBrush x:Key="CardTopHighlightBrush" Color="{DynamicResource CardTopHighlightColor}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{DynamicResource GridLineColor}"/>

    <!-- Per-metric identity colours for the dashboard cards. See the palette files for why
         this is a deliberate exception to "colour means state": the THERMAL card is excluded
         and still recolours from the live reading, so a real warning never competes with
         decoration for the same hue. -->
    <SolidColorBrush x:Key="MetricCpuBrush" Color="{DynamicResource MetricCpuColor}"/>
    <SolidColorBrush x:Key="MetricMemBrush" Color="{DynamicResource MetricMemColor}"/>
    <SolidColorBrush x:Key="MetricGpuBrush" Color="{DynamicResource MetricGpuColor}"/>

    <!-- Legacy gradient keys, kept so existing markup resolves. They are flat now: six
         competing gradients plus a decorative glow blob was the single biggest reason the
         old UI read as cheap, because nothing on screen was ever a calm surface to read
         data against. The sidebar shares the window background and is separated by one
         hairline rather than a fill change. -->
    <SolidColorBrush x:Key="AppBackgroundGradient" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarGradient" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardGradientBrush" Color="{DynamicResource PanelColor}"/>

    <!-- Depth without shadows. On a near-black ground a drop shadow renders as a muddy
         halo, so cards get a top-edge highlight instead: a 1px lighter line reads as
         "lit from above" and is most of what separates a designed surface from a plain
         rectangle. This is the vertical fade behind it, barely there by design. -->
    <LinearGradientBrush x:Key="CardSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CardTopHighlightColor}" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.55"/>
    </LinearGradientBrush>

    <!-- The accent ramp: the palette's two accent stops, left to right.

         This used to run AccentColor into AccentDimColor, which is the same hue at 22%
         alpha — a fade to transparent rather than a gradient, and it read as a smudge
         on anything wider than a button. Every palette now carries a genuine second
         stop, so a progress track has somewhere to travel to. Horizontal, because every
         consumer of it is a bar that fills left to right. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor2}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Pressure ramps. These read as a scale rather than as decoration: a bar that is
         green at the left and amber at the right says "the far end of this is bad"
         without needing a word beside it to say so, which is the one place colour is
         allowed to carry meaning here. -->
    <LinearGradientBrush x:Key="PressureGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource GoodColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource WarnColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CriticalGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource WarnColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource DangerColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoodGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource GoodColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor2}" Offset="1"/>
    </LinearGradientBrush>

    <!-- The unfilled part of any progress track. One key, so a track cannot drift.  -->
    <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource PanelAltColor}"/>

    <!-- Was a blue-to-white gradient painted across every big number. Gradient fills on
         numerals fight legibility at a glance, which is the one thing a telemetry readout
         has to do. Solid now; live values recolour themselves from the thermal scale. -->
    <SolidColorBrush x:Key="AccentTextGradient" Color="{DynamicResource TextPrimaryColor}"/>

    <!-- Retained for compatibility; the decorative ambient blob it fed is gone. -->
    <SolidColorBrush x:Key="GlowAccentBrush" Color="Transparent"/>

    <!-- Type. Cascadia Mono ships with Windows 11 and has proper tabular figures, so every
         numeric readout holds its column as digits change; Consolas is the fallback.
         Prose stays on the system UI face. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontSemibold">Segoe UI Variable Display Semibold, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontLight">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- One radius scale.

         This argued for near-sharp corners on the grounds that a large radius dissolves
         on a near-black ground. That was true of a barely-lifted surface with no border;
         it is not true here, because a card now carries a visible 1px border that holds
         the corner's shape whatever the fill does. Sm is for chips, tags and buttons;
         Md is the card. Pill is reserved for the status capsule in the title bar. -->
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- One spacing scale, to go beside the radius one above.
         There was no such thing: card geometry was written out at every call site, the same
         Padding of 16 repeated on thirty-eight separate borders, while CardBorderStyle's own
         default sat at 18, overridden everywhere and therefore never once used. A default no
         caller accepts is not a default, it is a second value to keep in sync. -->
    <Thickness x:Key="CardPaddingTight">16,13</Thickness>
    <Thickness x:Key="CardGap">0,0,0,18</Thickness>

</ResourceDictionary>
