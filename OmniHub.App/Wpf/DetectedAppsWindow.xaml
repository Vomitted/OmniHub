<Window x:Class="OmniHub.App.Wpf.DetectedAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Running App" Width="480" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundGradient}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Pick a running app" Style="{StaticResource HeadingText}" FontSize="20"/>
            <TextBlock Text="Only processes with a visible window are listed. You'll choose its GPU preference next."
                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4">
            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="AppList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="0,0,0,2" CornerRadius="4" Background="{StaticResource PanelAltBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding ProcessName}" Style="{StaticResource BodyText}" FontFamily="{StaticResource UiFontSemibold}"/>
                                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Height="36" Style="{StaticResource FlatButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Select" Width="90" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>
