<UserControl x:Class="OmniHub.App.Wpf.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Compare" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                           Text="Two stretches of this machine&apos;s own trace, measured and compared. It runs over history already on disk, so it can answer about changes made before anyone thought to start recording — and it says &quot;indistinguishable&quot; whenever that is the truth, which on a machine compared against itself is most of the time."/>
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <!-- Naming a stretch of time, so a measurement has something deliberate
                             to be compared against rather than whatever came before it. -->
                        <TextBlock Text="RECORD A RUN" Style="{StaticResource DataLabelText}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="SessionNameBox" Width="240" Height="36" VerticalContentAlignment="Center"
                                     Style="{StaticResource NumericTextBoxStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="SessionBtn" Content="START" Width="120" Height="36"
                                    Style="{StaticResource FlatButtonStyle}" Click="SessionBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="620"/>

                        <TextBlock Text="HOW MUCH OF EACH" Style="{StaticResource DataLabelText}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="WindowPills" Margin="0,0,0,14"/>

                        <TextBlock Text="COMPARE AGAINST" Style="{StaticResource DataLabelText}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="BaselinePills"/>

                        <!-- A named run, when there is one. The two pills above answer "did my
                             change help" and "is this machine behaving differently than
                             yesterday"; this answers "how does it compare to the run I named",
                             which is the only one of the three that survives somebody walking
                             away and coming back a week later. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="SessionPicker" MinWidth="280" VerticalAlignment="Center"
                                      SelectionChanged="SessionPicker_Changed"/>
                        </StackPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="ExportCsvBtn" Content="Export CSV" Width="130" Height="36"
                                    Margin="0,0,8,0" Style="{StaticResource FlatButtonStyle}" Click="ExportCsvBtn_Click"/>
                            <Button x:Name="ExportPngBtn" Content="Save as image" Width="150" Height="36"
                                    Style="{StaticResource FlatButtonStyle}" Click="ExportPngBtn_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="Status" Style="{StaticResource MutedText}" FontSize="11.5"
                                   Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="Verdict" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock x:Name="Verdict" Style="{StaticResource BodyText}" FontSize="13"
                                   TextWrapping="Wrap" MaxWidth="760" Text="Choose a window to begin."/>
                        <TextBlock x:Name="IntervalNote" Style="{StaticResource MutedText}" FontSize="11.5"
                                   Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="What was measured" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel x:Name="MetricRows"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
