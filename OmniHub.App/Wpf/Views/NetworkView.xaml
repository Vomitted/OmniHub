<UserControl x:Class="OmniHub.App.Wpf.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Network" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                           Text="Measures what your connection actually does. Nothing here routes your traffic or claims to lower your ping."/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Connection quality" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Average round trip is the number everyone quotes and the one least likely to be your problem. Jitter and loss are what a game feels: a rollback netcode visibly corrects on every jitter spike, and no netcode can rewind to a state it never received. One percent loss is worse than a hundred milliseconds of steady delay."/>

                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock Text="Host" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TargetBox" Width="220" Height="36" Margin="0,0,12,0" FontSize="13"
                                     Style="{StaticResource NumericTextBoxStyle}"/>
                            <Button x:Name="MeasureBtn" Content="Measure now" Width="140" Height="36" Margin="0,0,12,0"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="MeasureBtn_Click"/>
                            <Button x:Name="WatchBtn" Content="Pause monitoring" Width="170" Height="36"
                                    Style="{StaticResource FlatButtonStyle}" Click="WatchBtn_Click"/>
                        </WrapPanel>

                        <Grid x:Name="QualityTiles" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ROUND TRIP" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="RttValue" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="ms" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="RttFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="JITTER" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="JitterValue" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="ms" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="JitterFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PACKET LOSS" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="LossValue" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="%" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="LossFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="WORST (P95)" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="P95Value" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="ms" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="P95Foot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="MonitorStatus" Style="{StaticResource TileFoot}" Margin="0,12,0,0"/>
                        <TextBlock x:Name="QualityStatus" Style="{StaticResource MutedText}" FontSize="11.5"
                                   Margin="0,4,0,0" TextWrapping="Wrap" Text="Waiting for the first sample..."/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="Latency under load" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="The measurement most worth having, and the one almost nothing reports. If your ping is fine until a patch downloads or somebody starts a video call, oversized buffers in the modem and at your ISP are holding your packets rather than dropping them. This measures the connection idle, then again while deliberately filling it, and reports the difference. It downloads a few hundred megabytes to do that."/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="LoadTestBtn" Content="Test latency under load" Width="200" Height="36"
                                    Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="LoadTestBtn_Click"/>
                            <Button x:Name="LoadCancelBtn" Content="Stop" Width="110" Height="36" IsEnabled="False"
                                    Style="{StaticResource FlatButtonStyle}" Click="LoadCancelBtn_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="LoadHeadline" Style="{StaticResource BigNumberText}" Text="--"/>
                        <TextBlock x:Name="LoadStatus" Style="{StaticResource MutedText}" FontSize="11.5"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="700" Text="Not run yet."/>
                        <StackPanel x:Name="LoadDetail" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="Distance to server regions" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="For a far server most of the delay is the speed of light through fibre, and no software removes it. The floor column is the fastest that distance could possibly be answered; the overhead column is everything the real path adds on top. Only the overhead was ever available to improve, and that is precisely what a paid routing service sells you."/>

                        <Button x:Name="RegionBtn" Content="Measure again" Width="170" Height="36"
                                HorizontalAlignment="Left" Margin="0,0,0,14"
                                Style="{StaticResource FlatButtonStyle}" Click="RegionBtn_Click"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="REGION" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="1" Text="BEST" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="2" Text="JITTER" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="3" Text="FLOOR" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="4" Text="OVERHEAD" Style="{StaticResource TileLabel}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="RegionRows"/>
                        <TextBlock x:Name="RegionStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap" Text="Not measured yet."/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="Adapter settings worth knowing about" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Read from the driver, never written. Applying any of these resets the adapter and drops the link for a second or two, which is not something a button should do to you mid-match, so each carries the command that applies it and the choice stays yours. Expect small gains: these concern the adapter powering parts of itself down between packets, not your ping."/>
                        <StackPanel x:Name="AdapterRows"/>
                        <TextBlock x:Name="AdapterStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="What this deliberately does not do" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SectionRule}"/>
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="700"
                                   Text="OmniHub does not reduce your ping, and no purely local application can. The services that genuinely do it work by owning relay servers around the world and carrying your packets over their own transit, sometimes down several paths at once so a loss on one never reaches you. That is a network rather than a setting, and it is the one item on this page that costs money precisely because it is the one that requires hardware in other countries."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="700" Margin="0,10,0,0"
                                   Text="The tweaks left out were left out on purpose. Disabling Nagle does nothing for a game speaking UDP, which is most of them. NetworkThrottlingIndex governs a ceiling ordinary game traffic never approaches. Closing background processes was independently measured at a median of 2.4 frames per second. Where something real was found it is above, labelled with what it is actually worth."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="700" Margin="0,10,0,0"
                                   Text="If the load test comes back bloated, the fix is in your router rather than on this screen: enable SQM or QoS running fq_codel or CAKE, shaped to about ninety percent of your real line rate. That single change is worth more than every tweak on this page put together."/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
