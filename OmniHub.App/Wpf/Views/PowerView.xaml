<UserControl x:Class="OmniHub.App.Wpf.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <!-- The instrument on the left, the battery's own facts and its one setting on the right
         (technical/TECHNICAL-v5-ui.md). Three tiles each holding one number became three rows of
         one table, and a card repeating what the lede already says went. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,20">
        <StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Battery" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                           Text="Battery health and the firmware idle setting. CPU power limits live on Tuning; the Windows power plan lives on System."/>
            </StackPanel>

            <Grid x:Name="Columns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="Gutter" Width="10"/>
                    <ColumnDefinition x:Name="SideColumn" Width="270"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- One subtraction, set as one. This was four equal cards, which gave the remainder the
                     same weight as the measurement it is derived from and hid that three of the figures add
                     up to the fourth. As a table the arithmetic is on the page: the parts, a rule, and the
                     whole they come from, each beside the instrument that read it. The series colours are
                     marks at the start of each row rather than coloured words. -->
                <Border Grid.Column="0" Style="{StaticResource PaneStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Where the power is going" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto" MinWidth="64"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="PART" Style="{StaticResource DataLabelText}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="DRAW" Style="{StaticResource DataLabelText}"
                                       HorizontalAlignment="Right" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="READ FROM" Style="{StaticResource DataLabelText}" Margin="24,0,0,6"/>

                            <Border Grid.Row="1" Grid.Column="0" Width="3" Height="16" Margin="0,0,12,0"
                                    VerticalAlignment="Center" Background="{StaticResource MetricCpuBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Processor package" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DrawPackageValue" Text="--" FontFamily="{StaticResource MonoFont}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="W" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,3,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="DrawPackageFoot" Text="PACKAGE, FROM THE SMU" Style="{StaticResource TileFoot}"
                                       VerticalAlignment="Center" Margin="24,2,0,0"/>

                            <Border Grid.Row="2" Grid.Column="0" Width="3" Height="16" Margin="0,0,12,0"
                                    VerticalAlignment="Center" Background="{StaticResource MetricGpuBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Discrete GPU" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DrawGpuValue" Text="--" FontFamily="{StaticResource MonoFont}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="DrawGpuUnit" Text="W" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,3,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="DrawGpuFoot" Style="{StaticResource TileFoot}"
                                       VerticalAlignment="Center" Margin="24,2,0,0"/>

                            <Border Grid.Row="3" Grid.Column="0" Width="3" Height="16" Margin="0,0,12,0"
                                    VerticalAlignment="Center" Background="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Everything else" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DrawRestValue" Text="--" FontFamily="{StaticResource MonoFont}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="DrawRestUnit" Text="W" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,3,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" x:Name="DrawRestFoot" Text="A SUBTRACTION" Style="{StaticResource TileFoot}"
                                       VerticalAlignment="Center" Margin="24,2,0,0"/>

                            <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Height="1" Margin="0,4,0,4"
                                    Background="{StaticResource BorderStrongBrush}"/>

                            <Border Grid.Row="5" Grid.Column="0" Width="3" Height="16" Margin="0,0,12,0"
                                    VerticalAlignment="Center" Background="{StaticResource MetricMemBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Whole machine" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="DrawTotalValue" Text="--" FontFamily="{StaticResource MonoFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="W" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,3,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="4" x:Name="DrawTotalFoot" Text="AT THE BATTERY" Style="{StaticResource TileFoot}"
                                       VerticalAlignment="Center" Margin="24,2,0,0"/>
                        </Grid>

                        <TextBlock HorizontalAlignment="Left" x:Name="DrawNote" Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Side" Grid.Column="2">

                    <!-- Charge, health and cycles as rows: each was a tile holding one number. -->
                    <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="2" Text="The battery" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="Charge" Style="{StaticResource CellNote}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChargeValue" Style="{StaticResource BigNumberText}" FontSize="22" Text="--"/>
                                    <TextBlock Text="%" Style="{StaticResource TileUnit}" Margin="4,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="ChargeFoot" Style="{StaticResource TileFoot}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Health" Style="{StaticResource CellNote}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HealthValue" Style="{StaticResource BigNumberText}" FontSize="22" Text="--"/>
                                    <TextBlock x:Name="HealthUnit" Text="%" Style="{StaticResource TileUnit}" Margin="4,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="HealthFoot" Style="{StaticResource TileFoot}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="Cycles" Style="{StaticResource CellNote}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock x:Name="CyclesValue" Style="{StaticResource BigNumberText}" FontSize="22" Text="--"/>
                                <TextBlock x:Name="CyclesFoot" Style="{StaticResource TileFoot}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PaneStyle}">
                        <StackPanel>
                            <TextBlock Text="Idle mode" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Idle power saving" Style="{StaticResource BodyText}" FontSize="12.5"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="A firmware idle state exposed by the HP interface. HP does not document what it does, so this reports only whether the command was accepted, not what it changed."/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="IdleToggle" Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Top" Margin="0,2,0,0" Checked="IdleToggle_Changed" Unchecked="IdleToggle_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CPU power limits used to be here as well as on Tuning. Two screens writing the same two
                 BIOS commands with no shared state is how they ended up disagreeing about what the
                 machine was set to, so Tuning is now the only owner, as the lede says. -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
