<UserControl x:Class="OmniHub.App.Wpf.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <!-- TileLabel/TileValue/TileUnit/TileFoot come from Styles.xaml. This view wants the
             shared sizes exactly, so it defines none of its own; the copy that used to sit here
             was byte-identical to FansView's. -->
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Battery" Style="{StaticResource HeadingText}" FontSize="24"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                           Text="Battery health and the firmware idle setting. CPU power limits live on Tuning; the Windows power plan lives on System."/>
            </StackPanel>

            <TextBlock Text="BATTERY HEALTH" Style="{StaticResource SubHeadingText}"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="0,0,7,0">
                    <Grid>
                        <Border Style="{StaticResource CardSheenStyle}"/>
                        <StackPanel>
                            <TextBlock Text="CHARGE" Style="{StaticResource TileLabel}" Foreground="{StaticResource MetricMemBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="ChargeValue" Style="{StaticResource TileValue}" Text="--"/>
                                <TextBlock Text="%" Style="{StaticResource TileUnit}"/>
                            </StackPanel>
                            <TextBlock x:Name="ChargeFoot" Style="{StaticResource TileFoot}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="7,0">
                    <Grid>
                        <Border Style="{StaticResource CardSheenStyle}"/>
                        <StackPanel>
                            <TextBlock Text="HEALTH" Style="{StaticResource TileLabel}" Foreground="{StaticResource MetricCpuBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="HealthValue" Style="{StaticResource TileValue}" Text="--"/>
                                <TextBlock x:Name="HealthUnit" Text="%" Style="{StaticResource TileUnit}"/>
                            </StackPanel>
                            <TextBlock x:Name="HealthFoot" Style="{StaticResource TileFoot}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="7,0,0,0">
                    <Grid>
                        <Border Style="{StaticResource CardSheenStyle}"/>
                        <StackPanel>
                            <TextBlock Text="CYCLE COUNT" Style="{StaticResource TileLabel}" Foreground="{StaticResource MetricGpuBrush}"/>
                            <TextBlock x:Name="CyclesValue" Style="{StaticResource TileValue}" Text="--" Margin="0,4,0,0"/>
                            <TextBlock x:Name="CyclesFoot" Style="{StaticResource TileFoot}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="WHAT IS USING THE MACHINE" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="GPU and processor activity attributed to the processes causing it. What drains a laptop is rarely what anyone suspects: on this machine the largest GPU consumer during a battery investigation turned out to be the chat client being used to run the investigation."/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="DrainBtn" Content="Sample for 3 seconds" Width="190" Height="36"
                                    Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="DrainBtn_Click"/>
                            <TextBlock x:Name="DrainStatus" Style="{StaticResource MutedText}" FontSize="11.5"
                                       VerticalAlignment="Center" Text="Not sampled yet."/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="1" Text="GPU" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="3" Text="TIMER QUEUE" Style="{StaticResource TileLabel}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="DrainRows"/>

                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="700"
                                   Text="These are occupancy percentages, not watts. Nothing on this platform reports per-process energy accurately, and multiplying a percentage by a package power figure would produce a number with a unit on it that nobody measured. The timer queue is shown separately because it sits near 100% for processes doing almost no rendering, and folding it into the GPU column would make an idle application look like a game."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="IDLE MODE" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Idle power saving" Style="{StaticResource BodyText}"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" MaxWidth="560" TextWrapping="Wrap"
                                       Text="A firmware idle state exposed by the HP interface. Its exact behaviour is not documented by HP, so this reports only whether the command was accepted, not what it changed."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="IdleToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" Checked="IdleToggle_Changed" Unchecked="IdleToggle_Changed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- The wattage warning went with the sliders it was warning about. -->

            <!-- CPU power limits used to be here as well as on Tuning. Two screens writing the
                 same two BIOS commands with no shared state is how they ended up disagreeing
                 about what the machine was set to, so Tuning is now the only owner. -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
                <StackPanel Margin="17,13,14,13">
                    <TextBlock Text="LOOKING FOR CPU POWER LIMITS?" Style="{StaticResource TileLabel}"
                               Foreground="{StaticResource MetricCpuBrush}" Margin="0,0,0,5"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" MaxWidth="700"
                               Text="Sustained and boost wattage now live on the Tuning tab, together with the thermal limit and the adaptive controller, so there is one place that decides what the processor is allowed to draw."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
