<UserControl x:Class="OmniHub.App.Wpf.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OmniHub.App.Wpf.Controls"
             Background="{StaticResource BackgroundBrush}">
    <!-- The local TileLabel, TileValue and TileFoot copies that sat here are gone. The TileLabel
         copy shadowed the application's own without the text colour the shared one gained, so its
         labels drew in WPF's default black on a near-black card. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,20">
        <StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Graphics" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                           Text="GPU power level and the MUX graphics mode. Per-application routing lives on the App GPU Routing tab."/>
            </StackPanel>

            <Grid x:Name="Columns" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="Gutter" Width="10"/>
                    <ColumnDefinition x:Name="SideColumn" Width="250"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- What the card is actually doing, as rows of the same sensor table the Dashboard
                     uses: now, and the lowest, mean and highest since launch. This tab once had no
                     telemetry at all, then four tiles with one number each. -->
                <Border Grid.Column="0" Style="{StaticResource PaneStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Live" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="GpuSourceText" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <TextBlock x:Name="GpuNameText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8"/>
                        <ContentControl x:Name="SensorsHost" Focusable="False"/>
                        <TextBlock x:Name="GpuLiveFoot" Style="{StaticResource TileFoot}"/>
                    </StackPanel>
                </Border>

                <!-- What the BIOS says the card is set to. -->
                <Border x:Name="Side" Grid.Column="2" Style="{StaticResource PaneStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="State" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <!-- The card drawn: its temperature against its own hot point, its load and its
                             power against the limit the driver says it is held to. -->
                        <controls:RingGauge x:Name="GpuRing" Diameter="108" Caption="temperature" HorizontalAlignment="Center"/>
                        <controls:Meter x:Name="GpuLoadMeter" Label="Load" Margin="0,8,0,0"/>
                        <controls:Meter x:Name="GpuPowerMeter" Label="Power" Margin="0,7,0,0"/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,9"/>

                        <TextBlock Text="Graphics mode" Style="{StaticResource CellNote}"/>
                        <TextBlock x:Name="ModeText" Style="{StaticResource BodyText}" FontSize="17" FontWeight="SemiBold" Text="--" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ModeFoot" Style="{StaticResource TileFoot}" Text="READING..."/>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,9"/>

                        <TextBlock Text="Power" Style="{StaticResource CellNote}"/>
                        <TextBlock x:Name="PowerText" Style="{StaticResource BodyText}" FontSize="17" FontWeight="SemiBold" Text="--" Margin="0,2,0,0"/>
                        <TextBlock x:Name="PowerFoot" Style="{StaticResource TileFoot}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Power unlock" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Left" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12" MaxWidth="640" TextWrapping="Wrap"
                                       Text="Custom TGP and Dynamic Boost both ship disabled on this machine, which holds the discrete GPU at its stock power cap well below what the card is rated for. This is HP's own interface, so the firmware honours it. Re-applied at every launch, because it does not survive a reboot on its own."/>
                            <CheckBox x:Name="MaxPowerCheck" Content="Unlock GPU power (Custom TGP + Dynamic Boost)"
                                      Style="{StaticResource OmniCheckBoxStyle}"/>
                            <TextBlock x:Name="MaxPowerResult" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PresetCard" Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Power preset" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock HorizontalAlignment="Left" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12" MaxWidth="640" TextWrapping="Wrap"
                                   Text="Sets the GPU's TGP and boost flags through the HP interface. These take effect immediately and do not need a reboot."/>
                        <!-- A segmented selector, not three buttons. These are three states of
                             one setting, and the previous layout styled PERFORMANCE as the
                             primary action, which made it look permanently selected however the
                             GPU was actually configured. The checked pill is now set from the
                             flags read back off the BIOS. -->
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EcoBtn" GroupName="GpuPreset" Content="ECO" Width="120" Height="32" Style="{StaticResource PillRadioStyle}" Checked="EcoBtn_Click"/>
                                <RadioButton x:Name="BalancedBtn" GroupName="GpuPreset" Content="BALANCED" Width="120" Height="32" Margin="3,0" Style="{StaticResource PillRadioStyle}" Checked="BalancedBtn_Click"/>
                                <RadioButton x:Name="PerformanceBtn" GroupName="GpuPreset" Content="PERFORMANCE" Width="140" Height="32" Style="{StaticResource PillRadioStyle}" Checked="PerformanceBtn_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PresetResult" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="MUX / graphics mode" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Left" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12" MaxWidth="640" TextWrapping="Wrap"
                                       Text="Switches which GPU drives the internal display. Unlike the power preset above, this one requires a restart."/>
                            <WrapPanel>
                                <ComboBox x:Name="ModeCombo" Width="210" Height="36" Margin="0,0,12,0" Style="{StaticResource OmniComboBoxStyle}"/>
                                <Button x:Name="ChangeModeBtn" Content="Change Graphics Mode" Width="210" Height="36" Style="{StaticResource FlatButtonStyle}" Click="ChangeModeBtn_Click"/>
                            </WrapPanel>

                            <!-- Shown only when the firmware states this board cannot switch modes.
                                 Stays collapsed when the firmware declines to answer: unknown is
                                 not a denial. -->
                            <TextBlock HorizontalAlignment="Left" x:Name="ModeUnsupportedNote" Style="{StaticResource MutedText}" FontSize="11.5"
                                       Margin="0,10,0,0" MaxWidth="640" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The most destructive control in the app: picking Discrete on a laptop whose
                 dGPU is not wired to the internal panel leaves you with no video until you get
                 into Safe Mode. That warrants a full card and the danger colour, not a
                 footnote under the button. -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource DangerBrush}" CornerRadius="5,0,0,5"/>
                    <StackPanel Margin="17,13,14,13">
                        <TextBlock Text="READ BEFORE SWITCHING MODE" Style="{StaticResource TileLabel}" Margin="0,0,0,5"/>
                        <TextBlock HorizontalAlignment="Left" Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" MaxWidth="700"
                                   Text="This is not Advanced Optimus, and it takes effect only after a reboot. Switching to Discrete on a laptop where the dGPU is not wired to the internal display can leave you with no video output at all, recoverable only by booting into Safe Mode and switching back. If you are unsure which applies to your machine, leave this alone and use App GPU Routing instead."/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
