<UserControl x:Class="OmniHub.App.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OmniHub.App.Wpf.Controls"
             Background="{StaticResource BackgroundBrush}">

    <!-- The console (technical/TECHNICAL-v5-ui.md, 3.3).

         This page used to be a column: a limit card, the chart, four metric cards restating the
         bar above them, six chips duplicating controls from other pages, and a footer of prose.
         At the size the window opens at, the first screen showed two of those.

         Now it opens on the whole machine at once. Every reading with its session minimum, mean,
         maximum and trace on the left; on the right, the profile, what is holding the processor
         back, and what is in force; the last five minutes underneath. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
        <StackPanel>

            <!-- Shown ONLY when something this machine needs is missing. A readiness panel
                 that is always on screen saying "all good" is a permanent congratulation
                 nobody reads; one that appears only when a capability is genuinely absent
                 gets read the once it matters. -->
            <Border x:Name="ReadinessCard" Visibility="Collapsed" Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarnBrush}" Margin="-6,0,0,0"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="This machine" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock HorizontalAlignment="Left" x:Name="ReadinessHeadline" Style="{StaticResource BodyText}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ReadinessRows"/>
                        <Button x:Name="GetPawnIoBtn" Content="Install the PawnIO driver" Width="200" Height="36"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                Style="{StaticResource FlatButtonStyle}" Click="GetPawnIo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Two columns wide, one column narrow: below the width the sensor table needs beside
                 a 300 px column, the right-hand panes move underneath it (see Reflow). -->
            <Grid x:Name="Columns" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GutterColumn" Width="10"/>
                    <ColumnDefinition x:Name="SideColumn" Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Every reading: now, and since launch. -->
                <Border Grid.Column="0" Style="{StaticResource PaneStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Sensors" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="SensorsSince" Style="{StaticResource PaneMeta}" Margin="0,0,4,0"/>
                                <Button Content="reset" Style="{StaticResource LinkButtonStyle}" Click="ResetStats_Click"
                                        ToolTip="Start the minimum, mean and maximum columns again from now"/>
                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="SensorsHost" Focusable="False"/>
                    </DockPanel>
                </Border>

                <StackPanel x:Name="Side" Grid.Column="2">

                    <!-- The profile, and what it actually sets. The buttons alone never said that
                         Performance also pins both fans at maximum. -->
                    <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Profile" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="SilentBtn" GroupName="Preset" Content="Eco" Height="28" Style="{StaticResource PillRadioStyle}" Checked="SilentBtn_Checked"/>
                                    <RadioButton x:Name="BalancedBtn" GroupName="Preset" Content="Balanced" Height="28" Margin="3,0" Style="{StaticResource PillRadioStyle}" Checked="BalancedBtn_Checked"/>
                                    <RadioButton x:Name="PerformanceBtn" GroupName="Preset" Content="Performance" Height="28" Style="{StaticResource PillRadioStyle}" Checked="PerformanceBtn_Checked"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="ProfileNote" Style="{StaticResource FieldLabel}" Margin="1,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- What is holding the processor back, and what has been. -->
                    <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="What is limiting it" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <controls:LimitStrip x:Name="Limits"/>
                        </StackPanel>
                    </Border>

                    <!-- The settings the machine is running under, from four different pages. -->
                    <Border Style="{StaticResource PaneStyle}">
                        <StackPanel>
                            <TextBlock Text="In force" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <Grid x:Name="InForce">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Fans" Style="{StaticResource CellNote}" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FansText" Text="--" Style="{StaticResource CellLabel}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>

                                <TextBlock Grid.Row="1" Text="Graphics" Style="{StaticResource CellNote}" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GpuText" Text="--" Style="{StaticResource CellLabel}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>

                                <TextBlock Grid.Row="2" Text="Power" Style="{StaticResource CellNote}" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PowerDrawText" Text="--" Style="{StaticResource CellLabel}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>

                                <TextBlock Grid.Row="3" Text="Battery" Style="{StaticResource CellNote}" Margin="0,4,0,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BatteryText" Text="--" Style="{StaticResource CellLabel}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- How the readings got here: the die, what the fans did, what the curve asked for. -->
            <Border Style="{StaticResource PaneStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Last five minutes" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="die temperature · fan duty · commanded" Style="{StaticResource PaneMeta}"/>
                    </Grid>
                    <controls:TimeSeriesChart x:Name="TrendChart" Height="180"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
