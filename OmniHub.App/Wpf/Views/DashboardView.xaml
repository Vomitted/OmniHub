<UserControl x:Class="OmniHub.App.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OmniHub.App.Wpf.Controls"
             Background="{StaticResource BackgroundBrush}">

    <!-- The machine at a glance, drawn (technical/TECHNICAL-v5-ui.md, section 7).

         Four widgets lead: the processor and the graphics card as rings against their thermal
         thresholds, the fans as a fan that turns with them, the power as a battery filled to its
         charge, each with bars filled against the real limit of what they measure. Under them the
         last five minutes, what is limiting the processor, and the profile; under those, every
         reading as a table, which is the detail the widgets are drawn from. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
        <StackPanel>

            <!-- Shown ONLY when something this machine needs is missing. A readiness panel
                 that is always on screen saying "all good" is a permanent congratulation
                 nobody reads; one that appears only when a capability is genuinely absent
                 gets read the once it matters. -->
            <Border x:Name="ReadinessCard" Visibility="Collapsed" Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarnBrush}" Margin="-6,0,0,0"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="This machine" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock HorizontalAlignment="Left" x:Name="ReadinessHeadline" Style="{StaticResource BodyText}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ReadinessRows"/>
                        <Button x:Name="GetPawnIoBtn" Content="Install the PawnIO driver" Width="200" Height="36"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                Style="{StaticResource FlatButtonStyle}" Click="GetPawnIo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The four widgets. Four across, two by two on a narrow window (see Reflow). The
                 negative margin cancels the cards' outer gutters, so their edges line up with the
                 panes below. -->
            <UniformGrid x:Name="Hero" Columns="4" Margin="-5,0,-5,0">

                <Border Style="{StaticResource PaneStyle}" Margin="5,0,5,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Processor" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CpuClockMeta" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <controls:RingGauge x:Name="CpuRing" Diameter="116" Caption="die temperature" HorizontalAlignment="Center"/>
                        <controls:Meter x:Name="CpuLoadMeter" Label="Load" Margin="0,8,0,0"/>
                        <controls:Meter x:Name="CpuPowerMeter" Label="Package" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PaneStyle}" Margin="5,0,5,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Graphics" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="GpuClockMeta" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <controls:RingGauge x:Name="GpuRing" Diameter="116" Caption="GPU temperature" HorizontalAlignment="Center"/>
                        <controls:Meter x:Name="GpuLoadMeter" Label="Load" Margin="0,8,0,0"/>
                        <controls:Meter x:Name="GpuPowerMeter" Label="Power" Margin="0,7,0,0"/>
                        <TextBlock x:Name="GpuText" Text="--" Style="{StaticResource CellNote}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PaneStyle}" Margin="5,0,5,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cooling" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="FanModeMeta" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                            <controls:FanGlyph x:Name="Fan" Width="88" Height="88" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock x:Name="FanRpmText" Text="--" Style="{StaticResource BigNumberText}" FontSize="20"/>
                                <TextBlock Text="rpm" Style="{StaticResource TileUnit}" Margin="4,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                        <controls:Meter x:Name="Fan1Meter" Label="Fan 1" Margin="0,6,0,0"/>
                        <controls:Meter x:Name="Fan2Meter" Label="Fan 2" Margin="0,7,0,0"/>
                        <TextBlock x:Name="FansText" Text="--" Style="{StaticResource CellNote}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PaneStyle}" Margin="5,0,5,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Power" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="PowerSourceMeta" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                            <controls:BatteryGlyph x:Name="Battery" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock x:Name="ChargeText" Text="--" Style="{StaticResource BigNumberText}" FontSize="20"/>
                                <TextBlock Text="%" Style="{StaticResource TileUnit}" Margin="3,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                        <controls:Meter x:Name="MemMeter" Label="Memory" Margin="0,16,0,0"/>
                        <TextBlock x:Name="PowerDrawText" Text="--" Style="{StaticResource CellNote}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                        <TextBlock x:Name="BatteryText" Text="--" Style="{StaticResource CellNote}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- How the readings got here, beside what is holding the processor back and the profile.
                 Two columns wide, one column narrow (see Reflow). -->
            <Grid x:Name="Columns" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GutterColumn" Width="10"/>
                    <ColumnDefinition x:Name="SideColumn" Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PaneStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Last five minutes" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                            <TextBlock Text="die temperature · fan duty · commanded" Style="{StaticResource PaneMeta}"/>
                        </Grid>
                        <controls:TimeSeriesChart x:Name="TrendChart" Height="196"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Side" Grid.Column="2">

                    <!-- The profile, and what it actually sends. The buttons alone never said that
                         Performance also pins both fans at maximum. -->
                    <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Profile" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="SilentBtn" GroupName="Preset" Content="Eco" Height="28" Style="{StaticResource PillRadioStyle}" Checked="SilentBtn_Checked"/>
                                    <RadioButton x:Name="BalancedBtn" GroupName="Preset" Content="Balanced" Height="28" Margin="3,0" Style="{StaticResource PillRadioStyle}" Checked="BalancedBtn_Checked"/>
                                    <RadioButton x:Name="PerformanceBtn" GroupName="Preset" Content="Performance" Height="28" Style="{StaticResource PillRadioStyle}" Checked="PerformanceBtn_Checked"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="ProfileNote" Style="{StaticResource FieldLabel}" Margin="1,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- What is holding the processor back, and what has been. -->
                    <Border Style="{StaticResource PaneStyle}">
                        <StackPanel>
                            <TextBlock Text="What is limiting it" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <controls:LimitStrip x:Name="Limits"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- The detail: every reading, now and since launch, and where it came from. -->
            <Border Style="{StaticResource PaneStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Sensors" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SensorsSince" Style="{StaticResource PaneMeta}" Margin="0,0,4,0"/>
                            <Button Content="reset" Style="{StaticResource LinkButtonStyle}" Click="ResetStats_Click"
                                    ToolTip="Start the minimum, mean and maximum columns again from now"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="SensorsHost" Focusable="False"/>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
