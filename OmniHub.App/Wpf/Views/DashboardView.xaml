<UserControl x:Class="OmniHub.App.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OmniHub.App.Wpf.Controls"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>

        <!-- Metric card: coloured title, oversized value with a small unit suffix, a thin
             progress rail, then a two-fact footer. The value dominates and everything else
             is deliberately small, so a glance reads the number and the supporting detail is
             there only when you go looking for it. -->
        <Style x:Key="MetricTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontSemibold}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="LineHeight" Value="44"/>
        </Style>
        <Style x:Key="MetricUnit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="MetricFoot" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
        </Style>

        <!-- Quick-action chip. Not a toggle: each performs an action and reports the result. -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ScaleOnPress}">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>

            <!-- Shown ONLY when something this machine needs is missing. A readiness panel
                 that is always on screen saying "all good" is a permanent congratulation
                 nobody reads; one that appears only when a capability is genuinely absent
                 gets read the once it matters. -->
            <Border x:Name="ReadinessCard" Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Margin="0,0,0,16">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarnBrush}" CornerRadius="5,0,0,5"/>
                    <StackPanel Margin="17,13,14,13">
                        <TextBlock Text="THIS MACHINE" Style="{StaticResource MetricTitle}"
                                   Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ReadinessHeadline" Style="{StaticResource BodyText}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ReadinessRows"/>
                        <Button x:Name="GetPawnIoBtn" Content="Install the PawnIO driver" Width="200" Height="30"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                Style="{StaticResource FlatButtonStyle}" Click="GetPawnIo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- What is actually holding the processor back.
                 Hidden entirely without an SMU: with no PM table there is nothing to report, and
                 an empty set of bars would read as "no constraints" rather than "not measured".
                 Rows are built once and only their values move, so this costs nothing per tick. -->
            <Border x:Name="LimitsCard" Visibility="Collapsed"
                    Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="WHAT IS LIMITING THE PROCESSOR" Style="{StaticResource SubHeadingText}"/>
                        <TextBlock x:Name="LimitsHeadline" Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,10"/>
                        <StackPanel x:Name="LimitRows"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status strip: the facts worth knowing before anything else. -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="CPU TEMP" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="StripTemp" Text="--" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="CPU LOAD" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left" Foreground="{StaticResource MetricCpuBrush}"/>
                        <TextBlock x:Name="StripLoad" Text="--" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock x:Name="StripState" Text="--" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE ENGINE" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Title row + preset selector -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SYSTEMCORE" FontFamily="{StaticResource UiFontSemibold}" FontSize="27"
                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Style="{StaticResource ChipBorderStyle}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="14,4,0,0" BorderBrush="{StaticResource AccentDimBrush}">
                    <TextBlock x:Name="ModelText" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PerformanceBtn" GroupName="Preset" Content="MAX TURBO" Width="112" Height="30" Style="{StaticResource PillRadioStyle}" Checked="PerformanceBtn_Checked"/>
                        <RadioButton x:Name="BalancedBtn" GroupName="Preset" Content="SMART BALANCED" Width="140" Height="30" Margin="3,0" Style="{StaticResource PillRadioStyle}" Checked="BalancedBtn_Checked"/>
                        <RadioButton x:Name="SilentBtn" GroupName="Preset" Content="TRAVEL ECO" Width="112" Height="30" Style="{StaticResource PillRadioStyle}" Checked="SilentBtn_Checked"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick actions -->
            <WrapPanel Margin="0,0,0,16">
                <Button x:Name="ChipAutoGpu" Content="AUTO-GPU" Style="{StaticResource ChipButton}" Click="ChipAutoGpu_Click"/>
                <Button x:Name="ChipCleanRam" Content="CLEAN RAM" Style="{StaticResource ChipButton}" Click="ChipCleanRam_Click"/>
                <Button x:Name="ChipClearShaders" Content="CLEAR SHADERS" Style="{StaticResource ChipButton}" Click="ChipClearShaders_Click"/>
                <Button x:Name="ChipMaxFans" Content="100% FANS" Style="{StaticResource ChipButton}" Click="ChipMaxFans_Click"/>
                <Button x:Name="ChipAutoFans" Content="AUTO FANS" Style="{StaticResource ChipButton}" Click="ChipAutoFans_Click"/>
                <Button x:Name="ChipTimer" Content="HI-RES TIMER" Style="{StaticResource ChipButton}" Click="ChipTimer_Click"/>
                <TextBlock x:Name="ChipResult" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                           Margin="6,0,0,7" TextWrapping="Wrap" MaxWidth="360"/>
            </WrapPanel>

            <!-- Instrument row -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="0,0,14,14">
                        <Grid>
                            <Border Style="{StaticResource CardSheenStyle}"/>
                            <StackPanel>
                                <TextBlock Text="COMPUTE UNIT" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left" Foreground="{StaticResource MetricCpuBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="CpuClockText" Style="{StaticResource MetricValue}" Text="--"/>
                                    <TextBlock Text="GHz" Style="{StaticResource MetricUnit}"/>
                                </StackPanel>
                                <Grid x:Name="CpuLoadBar" Height="3" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource MetricCpuBrush}" CornerRadius="2"/>
                                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="2"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock x:Name="CpuFootLeft" Style="{StaticResource MetricFoot}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="CpuLoadText" Style="{StaticResource MetricFoot}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="0,0,14,0">
                        <Grid>
                            <Border Style="{StaticResource CardSheenStyle}"/>
                            <StackPanel>
                                <TextBlock Text="MEMORY ALLOCATION" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left" Foreground="{StaticResource MetricMemBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="MemText" Style="{StaticResource MetricValue}" Text="--"/>
                                    <TextBlock Text="GB" Style="{StaticResource MetricUnit}"/>
                                </StackPanel>
                                <Grid x:Name="MemLoadBar" Height="3" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource MetricMemBrush}" CornerRadius="2"/>
                                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="2"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock x:Name="MemSubText" Style="{StaticResource MetricFoot}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="MemFootRight" Style="{StaticResource MetricFoot}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <controls:CircularGauge x:Name="Gauge" Grid.Column="1" Width="250" Height="250"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="14,0,0,14">
                        <Grid>
                            <Border Style="{StaticResource CardSheenStyle}"/>
                            <StackPanel>
                                <TextBlock Text="GPU THERMAL" Style="{StaticResource MetricTitle}" Foreground="{StaticResource MetricGpuBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock x:Name="GpuTempText" Style="{StaticResource MetricValue}" Text="--"/>
                                    <TextBlock x:Name="GpuTempUnit" Text="&#176;C" Style="{StaticResource MetricUnit}"/>
                                </StackPanel>
                                <Grid x:Name="GpuBar" Height="3" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="GpuBarFill" Grid.Column="0" Background="{StaticResource MetricGpuBrush}" CornerRadius="2"/>
                                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="2"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock x:Name="GpuSubText" Style="{StaticResource MetricFoot}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="GpuFootRight" Style="{StaticResource MetricFoot}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,13" Margin="14,0,0,0">
                        <Grid>
                            <Border Style="{StaticResource CardSheenStyle}"/>
                            <StackPanel>
                                <TextBlock x:Name="ThermalTitle" Text="CPU THERMAL" Style="{StaticResource MetricTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock x:Name="ThermalText" Style="{StaticResource MetricValue}" Text="--"/>
                                    <TextBlock x:Name="ThermalUnit" Text="&#176;C" Style="{StaticResource MetricUnit}"/>
                                </StackPanel>
                                <Grid x:Name="ThermalBar" Height="3" Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ThermalBarFill" Grid.Column="0" Background="{StaticResource DangerBrush}" CornerRadius="2"/>
                                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" CornerRadius="2"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock x:Name="ThermalSubText" Style="{StaticResource MetricFoot}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ThermalFootRight" Style="{StaticResource MetricFoot}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Telemetry -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,13">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="HISTORICAL TELEMETRY / TEMPERATURE" Style="{StaticResource MetricTitle}" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Style="{StaticResource ChipBorderStyle}" HorizontalAlignment="Right" BorderBrush="{StaticResource AccentDimBrush}">
                                <TextBlock x:Name="TrendWindowText" Text="LIVE" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>
                        <controls:WaveformChart x:Name="TrendChart" Height="104"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Power footer -->
            <Grid Margin="2,14,2,0">
                <TextBlock x:Name="PowerStateText" Style="{StaticResource MutedText}" FontSize="11.5" HorizontalAlignment="Left"/>
                <TextBlock x:Name="BatteryText" Style="{StaticResource MutedText}" FontSize="11.5" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextFaintBrush}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
