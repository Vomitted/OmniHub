<UserControl x:Class="OmniHub.App.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OmniHub.App.Wpf.Controls"
             Background="{StaticResource BackgroundBrush}">

    <!-- The machine at a glance, built to the reference the user supplied
         (technical/TECHNICAL-v5-ui.md, section 9): a header with the presets, a card per component
         down each side of a dial, the history on one clock under them, then what is limiting the
         processor, then every reading as a tile. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="22,16,22,18">
        <StackPanel>

            <!-- Shown ONLY when something this machine needs is missing. A readiness panel
                 that is always on screen saying "all good" is a permanent congratulation
                 nobody reads; one that appears only when a capability is genuinely absent
                 gets read the once it matters. -->
            <Border x:Name="ReadinessCard" Visibility="Collapsed" Style="{StaticResource PaneStyle}" Margin="0,0,0,12">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarnBrush}" Margin="-6,0,0,0"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="This machine" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock HorizontalAlignment="Left" x:Name="ReadinessHeadline" Style="{StaticResource BodyText}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="760" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ReadinessRows"/>
                        <Button x:Name="GetPawnIoBtn" Content="Install the PawnIO driver" Width="200" Height="36"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                Style="{StaticResource FlatButtonStyle}" Click="GetPawnIo_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What this is and which machine, and the presets: what each one sends is written under them. -->
            <Grid Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Overview" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="MachineLine" Style="{StaticResource CellNote}" FontSize="12" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}" Padding="3" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PerformanceBtn" GroupName="Preset" Content="PERFORMANCE" Height="30"
                                         Style="{StaticResource SegmentRadioStyle}" Checked="PerformanceBtn_Checked"/>
                            <RadioButton x:Name="BalancedBtn" GroupName="Preset" Content="BALANCED" Height="30" Margin="3,0"
                                         Style="{StaticResource SegmentRadioStyle}" Checked="BalancedBtn_Checked"/>
                            <RadioButton x:Name="SilentBtn" GroupName="Preset" Content="ECO" Height="30"
                                         Style="{StaticResource SegmentRadioStyle}" Checked="SilentBtn_Checked"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ProfileNote" Style="{StaticResource CellNote}" HorizontalAlignment="Right" Margin="0,7,4,0"/>
                </StackPanel>
            </Grid>

            <!-- The console: a card per component down each side of the dial. Five columns wide,
                 and on a narrow window the dial across the top with the cards two by two under it
                 (see Reflow). -->
            <Grid x:Name="Console" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="LeftGap" Width="14"/>
                    <ColumnDefinition x:Name="CentreColumn" Width="1.3*"/>
                    <ColumnDefinition x:Name="RightGap" Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="StackedGap" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ComponentCard x:Name="CpuCard" Category="Processor" ColourKey="MetricCpuBrush"/>
                <controls:ComponentCard x:Name="MemCard" Grid.Row="2" Category="System" Title="Memory" ColourKey="MetricMemBrush"/>

                <Border x:Name="Centre" Grid.Column="2" Grid.RowSpan="3" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}"
                        ClipToBounds="True" MinHeight="380">
                    <controls:HeroDial x:Name="Dial" Label="DIE TEMPERATURE"/>
                </Border>

                <controls:ComponentCard x:Name="GpuCard" Grid.Column="4" Category="Graphics" ColourKey="MetricGpuBrush" StripeRight="True"/>
                <controls:ComponentCard x:Name="CoolCard" Grid.Row="2" Grid.Column="4" Category="Cooling" Title="Fans"
                                        ColourKey="MetricFanBrush" StripeRight="True"/>
            </Grid>

            <!-- The history: four strips on one clock, filled from what the readings source kept
                 recording while nobody was looking (see ChartStack). -->
            <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="History" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="HistoryMeta" Text="live" Style="{StaticResource PaneMeta}" Margin="0,0,12,0"/>
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="HistoryWindow" Content="5 min" Tag="5" Width="60" Height="26" IsChecked="True"
                                                 Style="{StaticResource PillRadioStyle}" Checked="HistoryWindow_Checked"/>
                                    <RadioButton GroupName="HistoryWindow" Content="15 min" Tag="15" Width="60" Height="26" Margin="2,0"
                                                 Style="{StaticResource PillRadioStyle}" Checked="HistoryWindow_Checked"/>
                                    <RadioButton GroupName="HistoryWindow" Content="30 min" Tag="30" Width="60" Height="26"
                                                 Style="{StaticResource PillRadioStyle}" Checked="HistoryWindow_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="HistoryHost" Focusable="False"/>
                </StackPanel>
            </Border>

            <!-- What is holding the processor back, and what has been. -->
            <Border Style="{StaticResource PaneStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="What is limiting it" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <controls:LimitStrip x:Name="Limits"/>
                </StackPanel>
            </Border>

            <!-- The detail: every reading, now and since launch, as a tile. -->
            <Border Style="{StaticResource PaneStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Sensors" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SensorsSince" Style="{StaticResource PaneMeta}" Margin="0,0,4,0"/>
                            <Button Content="reset" Style="{StaticResource LinkButtonStyle}" Click="ResetStats_Click"
                                    ToolTip="Start the minimum, mean and maximum again from now"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="SensorsHost" Focusable="False"/>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
