<UserControl x:Class="OmniHub.App.Wpf.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Diagnostics" Style="{StaticResource HeadingText}" FontSize="24"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                           Text="Measure what this machine actually does, and read back what its firmware says it can do."/>
            </StackPanel>

            <TextBlock Text="LOAD TEST" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Loads every core and records temperature, package power, CPU clock and fan speed. Run it once before a change and once after: the clock floor and the p90 temperature are what move when sustained behaviour does. The machine will get hot. Nothing here commands a fan or writes a power limit."/>

                        <WrapPanel Margin="0,0,0,12">
                            <ComboBox x:Name="DurationCombo" Width="150" Height="36" Margin="0,0,12,0"
                                      Style="{StaticResource OmniComboBoxStyle}"/>
                            <Button x:Name="RunBtn" Content="Run load test" Width="150" Height="36"
                                    Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="RunBtn_Click"/>
                            <Button x:Name="StopBtn" Content="Stop" Width="110" Height="36" IsEnabled="False"
                                    Style="{StaticResource FlatButtonStyle}" Click="StopBtn_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="RunStatus" Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap" Text="Not started."/>
                        <TextBlock x:Name="RunLive" Style="{StaticResource TileFoot}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="RunSummary" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="WHAT THE FIRMWARE REPORTS" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Read from the board rather than from a list of model numbers. Where a capability reads as unavailable, the control stays enabled unless the firmware states plainly that it is unsupported: a reply carrying nothing is an unknown, not a refusal."/>
                        <StackPanel x:Name="CapabilityRows"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="PROBE REPORT" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Saves everything the BIOS reports about this laptop to a text file, unmodified. This is the evidence a board nobody has tested needs before its fan curve can be trusted, and it is what a per-model profile gets written from."/>
                        <Button x:Name="SaveProbeBtn" Content="Save probe report" Width="180" Height="36"
                                HorizontalAlignment="Left" Style="{StaticResource FlatButtonStyle}" Click="SaveProbeBtn_Click"/>
                        <TextBlock x:Name="ProbeStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="PM TABLE EXPLORER" Style="{StaticResource SubHeadingText}" Margin="0,18,0,8"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="This application reads 22 fields from a table with hundreds of words in it, and leaves the rest unmapped rather than guessing what they are. This is how the 22 were found: capture the table, change one thing about the machine, capture it again, and see which words moved."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Nothing here is given a name it has not earned. A word is reported as a number at a position, and only the handful already confirmed against readings from elsewhere are labelled."/>
                        <WrapPanel>
                            <Button x:Name="CaptureTableBtn" Content="Capture" Width="130" Height="36"
                                    Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Click="CaptureTableBtn_Click"/>
                            <Button x:Name="ClearTableBtn" Content="Forget capture" Width="150" Height="36"
                                    IsEnabled="False" Style="{StaticResource FlatButtonStyle}" Click="ClearTableBtn_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TableStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                        <StackPanel x:Name="TableChanges" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="SUPPORT BUNDLE" Style="{StaticResource SubHeadingText}" Margin="0,18,0,8"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Collects the thermal trace, the power transitions, the poll timings, the crash log, the firmware report above and your settings into one archive. It is the same list assembled by hand every time this machine has needed diagnosing, which is what makes it worth a button."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="The archive includes your settings file, which carries the paths of any applications you have given a graphics preference. A manifest inside lists everything collected. Nothing is sent anywhere -- the file is written to disk and what happens to it next is your decision."/>
                        <Button x:Name="SaveBundleBtn" Content="Save support bundle" Width="200" Height="36"
                                HorizontalAlignment="Left" Style="{StaticResource FlatButtonStyle}" Click="SaveBundleBtn_Click"/>
                        <TextBlock x:Name="BundleStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
