<UserControl x:Class="OmniHub.App.Wpf.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Diagnostics" Style="{StaticResource HeadingText}" FontSize="24"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                           Text="Measure what this machine actually does, and read back what its firmware says it can do."/>
            </StackPanel>

            <TextBlock Text="COOLING HEALTH" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="How many degrees of temperature rise each watt buys. Temperature on its own cannot tell a blocked heatsink from a healthy one: 80 degrees drawing 15 watts and 80 degrees drawing 50 watts are completely different machines. This ratio is a property of the heatsink, the paste and the dust in the fins, and it degrades far too slowly to notice by feel."/>
                        <TextBlock x:Name="CoolingSummary" Style="{StaticResource BodyText}" FontSize="11.5"
                                   TextWrapping="Wrap" MaxWidth="700" Margin="0,0,0,12" Text="Reading the logs..."/>
                        <StackPanel x:Name="CoolingRows"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="700"
                                   Text="Ambient temperature is not measured. Each day's own idle floor stands in for it, which is fair while the laptop lives in the same room and wrong the week it moves somewhere hotter. The power and fan level beside each day are there so you can see whether two days are comparable at all."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="STABILITY" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Every time this machine stopped without being asked to. Windows records one of these on the next boot, and the payload says whether a crash dump was written and whether it happened during a sleep transition. A freeze that leaves no dump is otherwise almost impossible to investigate, because by definition nothing was written down."/>
                        <TextBlock x:Name="StabilitySummary" Style="{StaticResource BodyText}" FontSize="11.5"
                                   TextWrapping="Wrap" MaxWidth="700" Margin="0,0,0,12" Text="Reading the event log..."/>
                        <StackPanel x:Name="StabilityRows"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="SESSION REPORT" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Reads back the logs this application already writes and says what happened. Every number here was measured at the time; the thresholds behind each conclusion are named in the conclusion, so you can disagree with one without having to guess what it was."/>

                        <WrapPanel Margin="0,0,0,14">
                            <TextBlock Text="Day" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ReportDateCombo" Width="180" Height="36" Margin="0,0,12,0"
                                      Style="{StaticResource OmniComboBoxStyle}" SelectionChanged="ReportDate_Changed"/>
                            <Button x:Name="ReportRefreshBtn" Content="Refresh" Width="120" Height="36"
                                    Margin="0,0,12,0" Style="{StaticResource FlatButtonStyle}" Click="ReportRefresh_Click"/>
                            <Button x:Name="ReportCopyBtn" Content="Copy report" Width="140" Height="36"
                                    Style="{StaticResource FlatButtonStyle}" Click="ReportCopy_Click"/>
                        </WrapPanel>

                        <Grid x:Name="ReportTiles" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LOGGED" Style="{StaticResource TileLabel}"/>
                                <TextBlock x:Name="RepDuration" Style="{StaticResource TileValue}" FontSize="24" Text="--" Margin="0,4,0,0"/>
                                <TextBlock x:Name="RepSamples" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TYPICAL TEMP" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="RepMedianTemp" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="&#176;C" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="RepTempFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TYPICAL FAN" Style="{StaticResource TileLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="RepMedianFan" Style="{StaticResource TileValue}" Text="--"/>
                                    <TextBlock Text="%" Style="{StaticResource TileUnit}"/>
                                </StackPanel>
                                <TextBlock x:Name="RepFanFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="THROTTLED" Style="{StaticResource TileLabel}"/>
                                <TextBlock x:Name="RepThrottled" Style="{StaticResource TileValue}" FontSize="24" Text="--" Margin="0,4,0,0"/>
                                <TextBlock x:Name="RepThrottleFoot" Style="{StaticResource TileFoot}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ReportFindings"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="LOAD TEST" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Loads every core and records temperature, package power, CPU clock and fan speed. Run it once before a change and once after: the clock floor and the p90 temperature are what move when sustained behaviour does. The machine will get hot. Nothing here commands a fan or writes a power limit."/>

                        <WrapPanel Margin="0,0,0,12">
                            <ComboBox x:Name="DurationCombo" Width="150" Height="36" Margin="0,0,12,0"
                                      Style="{StaticResource OmniComboBoxStyle}"/>
                            <Button x:Name="RunBtn" Content="Run load test" Width="150" Height="36"
                                    Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Click="RunBtn_Click"/>
                            <Button x:Name="StopBtn" Content="Stop" Width="110" Height="36" IsEnabled="False"
                                    Style="{StaticResource FlatButtonStyle}" Click="StopBtn_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="RunStatus" Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap" Text="Not started."/>
                        <TextBlock x:Name="RunLive" Style="{StaticResource TileFoot}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="RunSummary" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="WHAT THE FIRMWARE REPORTS" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Read from the board rather than from a list of model numbers. Where a capability reads as unavailable, the control stays enabled unless the firmware states plainly that it is unsupported: a reply carrying nothing is an unknown, not a refusal."/>
                        <StackPanel x:Name="CapabilityRows"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="PROBE REPORT" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,12"
                                   MaxWidth="700" TextWrapping="Wrap"
                                   Text="Saves everything the BIOS reports about this laptop to a text file, unmodified. This is the evidence a board nobody has tested needs before its fan curve can be trusted, and it is what a per-model profile gets written from."/>
                        <Button x:Name="SaveProbeBtn" Content="Save probe report" Width="180" Height="36"
                                HorizontalAlignment="Left" Style="{StaticResource FlatButtonStyle}" Click="SaveProbeBtn_Click"/>
                        <TextBlock x:Name="ProbeStatus" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
