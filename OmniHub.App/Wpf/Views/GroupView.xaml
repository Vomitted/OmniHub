<UserControl x:Class="OmniHub.App.Wpf.Views.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The sections, as document tabs across the top of the page.

             They used to be the segmented control the fan mode and the power profile use, which
             drew "which screen am I looking at" exactly like "what are the fans doing", one above
             the other. A tab changes what is shown and never what the hardware does, so it looks
             like a tab: text, an accent line under the chosen one, a hairline under the row. -->
        <Grid Grid.Row="0" Margin="18,6,18,0">
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}"/>
            <StackPanel x:Name="Selector" Orientation="Horizontal"/>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="Host"/>
    </Grid>
</UserControl>
