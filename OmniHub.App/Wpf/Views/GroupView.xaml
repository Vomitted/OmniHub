<UserControl x:Class="OmniHub.App.Wpf.Views.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The sub-selector, in the same segmented style the Dashboard and Fans tabs use for a
             set of mutually exclusive states. It sits above the hosted screen rather than inside
             it, so the screen below stays exactly the view it always was. -->
        <Border Grid.Row="0" Margin="26,20,26,0" HorizontalAlignment="Left"
                Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="3">
            <StackPanel x:Name="Selector" Orientation="Horizontal"/>
        </Border>

        <ContentControl Grid.Row="1" x:Name="Host"/>
    </Grid>
</UserControl>
