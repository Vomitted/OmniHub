<UserControl x:Class="OmniHub.App.Wpf.Views.AppRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,20">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="App GPU routing" Style="{StaticResource PageTitle}"/>
                    <!-- Says "discrete GPU", not a model name. The previous copy hardcoded
                         "RTX 4060", which this app never detects or verifies: exactly the
                         fabricated-hardware-identity problem called out in the OmniControl
                         teardown, and simply wrong on any other machine. -->
                    <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                               Text="Pin individual applications to the discrete GPU or the integrated one. This writes the same Windows setting as Settings &gt; Display &gt; Graphics, so anything set here stays visible and reversible there."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Detect Running App" Width="168" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource FlatButtonStyle}" Click="DetectAppBtn_Click"/>
                    <Button Content="Browse" Width="104" Height="36"
                            Style="{StaticResource PrimaryButtonStyle}" Click="AddAppBtn_Click"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource PaneStyle}">
                <StackPanel>
                    <TextBlock Text="Routed applications" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                    <!-- Filters the list below rather than searching the disk. The rows are routes that
                         already exist, and the only reason to look for one is to change or remove it. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SearchBox" Height="36" FontSize="13"
                                 Style="{StaticResource NumericTextBoxStyle}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Grid.Column="1" x:Name="SearchCount" Style="{StaticResource TileFoot}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <ContentControl x:Name="AppList"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
