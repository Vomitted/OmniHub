<UserControl x:Class="OmniHub.App.Wpf.Views.AppRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <!-- No outer ScrollViewer: the list scrolls itself. A virtualising list inside a ScrollViewer is
         measured at infinite height and builds every row anyway, which is the freeze this page had
         with four hundred routes (TECHNICAL-v5-ui.md, section 14). -->
    <Grid Margin="18,14,18,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="App GPU routing" Style="{StaticResource PageTitle}"/>
                <!-- Says "discrete GPU", not a model name. The previous copy hardcoded
                     "RTX 4060", which this app never detects or verifies: exactly the
                     fabricated-hardware-identity problem called out in the OmniControl
                     teardown, and simply wrong on any other machine. -->
                <TextBlock Style="{StaticResource PageLede}" Margin="0,4,0,0"
                           Text="Pin individual applications to the discrete GPU or the integrated one. This writes the same Windows setting as Settings &gt; Display &gt; Graphics, so anything set here stays visible and reversible there."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Detect Running App" Width="168" Height="36" Margin="0,0,8,0"
                        Style="{StaticResource FlatButtonStyle}" Click="DetectAppBtn_Click"/>
                <Button Content="Browse" Width="104" Height="36"
                        Style="{StaticResource PrimaryButtonStyle}" Click="AddAppBtn_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PaneStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Routed applications" Style="{StaticResource PaneTitle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <!-- Which preference to show, each with how many hold it, beside a search over the
                     whole path. Both narrow the same list and combine. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShowAllBtn" GroupName="RouteFilter" Height="30" Padding="12,0" IsChecked="True"
                                         Style="{StaticResource PillRadioStyle}" Checked="PreferenceFilter_Checked" Tag="All"/>
                            <RadioButton x:Name="ShowHighBtn" GroupName="RouteFilter" Height="30" Margin="3,0,0,0"
                                         Style="{StaticResource PillRadioStyle}" Checked="PreferenceFilter_Checked" Tag="HighPerformance"/>
                            <RadioButton x:Name="ShowSavingBtn" GroupName="RouteFilter" Height="30" Margin="3,0,0,0"
                                         Style="{StaticResource PillRadioStyle}" Checked="PreferenceFilter_Checked" Tag="PowerSaving"/>
                            <RadioButton x:Name="ShowAutoBtn" GroupName="RouteFilter" Height="30" Margin="3,0,0,0"
                                         Style="{StaticResource PillRadioStyle}" Checked="PreferenceFilter_Checked" Tag="Auto"/>
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Height="36" FontSize="13" VerticalContentAlignment="Center"
                             Style="{StaticResource NumericTextBoxStyle}" TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Search routed applications"/>
                    <TextBlock Grid.Column="2" x:Name="SearchCount" Style="{StaticResource TileFoot}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>

                <TextBlock x:Name="EmptyNote" DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>

                <!-- Only the rows on screen exist: about a dozen, whatever the count. -->
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalContentAlignment="Stretch" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,9,4,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- The file name, and the folder under it: two builds of one game
                                         share an executable, and the folder is what tells them apart. -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="10.5"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- The preference in one click, and legible without opening anything.
                                         No GroupName: each row's three group by their own panel. -->
                                    <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="WINDOWS DECIDES" Height="26" Style="{StaticResource SegmentRadioStyle}"
                                                         IsChecked="{Binding IsAuto, Mode=TwoWay}" AutomationProperties.Name="Let Windows decide"/>
                                            <RadioButton Content="POWER SAVING" Height="26" Style="{StaticResource SegmentRadioStyle}"
                                                         IsChecked="{Binding IsSaving, Mode=TwoWay}" AutomationProperties.Name="Power saving"/>
                                            <RadioButton Content="HIGH PERFORMANCE" Height="26" Style="{StaticResource SegmentRadioStyle}"
                                                         IsChecked="{Binding IsHigh, Mode=TwoWay}" AutomationProperties.Name="High performance"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" Content="Remove" Width="80" MinHeight="36" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Style="{StaticResource FlatButtonStyle}" Click="Remove_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
