<UserControl x:Class="OmniHub.App.Wpf.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,24">
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Stability" Style="{StaticResource HeadingText}" FontSize="24"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" MaxWidth="760" TextWrapping="Wrap"
                           Text="Every time this machine stopped without shutting down, reconstructed from Windows&apos; own records and from this application&apos;s thermal trace. It reports what happened and when. It does not say why, because nothing here knows why."/>
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="SUMMARY" Style="{StaticResource DataLabelText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" FontSize="12.5"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="RefreshBtn" Content="Refresh" Width="110" Height="36"
                                    Style="{StaticResource FlatButtonStyle}" Click="RefreshBtn_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="ReadError" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="INCIDENTS" Style="{StaticResource SubHeadingText}"/>
            <StackPanel x:Name="Incidents"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
