<UserControl x:Class="OmniHub.App.Wpf.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,28">
        <StackPanel>

            <TextBlock Text="System" Style="{StaticResource HeadingText}" FontSize="24"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,22" MaxWidth="640" TextWrapping="Wrap"
                       Text="Every action here reports what it measurably did. Where Windows gives nothing back, it says so rather than claiming a win."/>

            <!-- PERFORMANCE MODE was here. It set the GPU power level and the Windows power
                 plan: the first duplicating the Dashboard's three presets, the second
                 duplicating the WINDOWS POWER PLAN card at the bottom of this same page. -->

            <TextBlock Text="SCHEDULING" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TIMER RESOLUTION" Style="{StaticResource DataLabelText}" VerticalAlignment="Center"/>
                                    <Border x:Name="TimerChip" Style="{StaticResource StatusChipStyle}">
                                        <TextBlock x:Name="TimerChipText" Style="{StaticResource StatusChipText}" Text="OFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TimerValue" Style="{StaticResource BigNumberText}" FontSize="24" Text="--" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TimerSub" Style="{StaticResource MutedText}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="TimerToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center" Checked="TimerToggle_Changed" Unchecked="TimerToggle_Changed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="A finer timer makes the scheduler wake more often, which smooths frame pacing and input handling. It also measurably increases idle power draw, so this is a trade rather than a free win. Leave it off on battery."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DWM MULTIMEDIA PRIORITY" Style="{StaticResource DataLabelText}" VerticalAlignment="Center"/>
                                <Border x:Name="MmcssChip" Style="{StaticResource StatusChipStyle}">
                                    <TextBlock x:Name="MmcssChipText" Style="{StaticResource StatusChipText}" Text="OFF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Runs desktop composition on the multimedia scheduler."/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" MaxWidth="560" TextWrapping="Wrap"
                                       Text="Raises the compositor thread's priority. Helps most with stutter while the CPU is saturated. Windows may reset this on its own schedule, so it is not persistent."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="MmcssToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" Checked="MmcssToggle_Changed" Unchecked="MmcssToggle_Changed"/>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Text="BATTERY" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="LIVE DRAW" Style="{StaticResource DataLabelText}"/>
                        <TextBlock x:Name="DrawValue" Style="{StaticResource BigNumberText}" FontSize="24" Text="--" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DrawSub" Style="{StaticResource MutedText}" FontSize="11"/>

                        <TextBlock Text="DISPLAY BRIGHTNESS" Style="{StaticResource DataLabelText}" Margin="0,16,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- ValueChanged, not Thumb.DragCompleted. DragCompleted fires only for an
                                 actual thumb drag, so clicking the track or nudging with the arrow keys
                                 moved the label without ever applying the brightness. The handler
                                 debounces, which is what DragCompleted was being used to achieve. -->
                            <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="10" Maximum="100" Value="80"
                                    TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="Brightness_ValueChanged"/>
                            <TextBlock x:Name="BrightnessLabel" Grid.Column="1" Text="--" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="The panel is usually the single largest consumer on a laptop, which makes this the most effective battery lever available without a driver. Runtime is capacity divided by measured draw at this instant, so it moves when load moves; it is not smoothed to look reassuring."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BatterySaverBtn" Content="Battery Saver" Style="{StaticResource FlatButtonStyle}" Click="BatterySaverBtn_Click"/>
                            <Button x:Name="UndoBrightnessBtn" Content="Undo Dim" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0"
                                    IsEnabled="False" Click="UndoBrightnessBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="BatteryResult" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="MEMORY" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="AVAILABLE PHYSICAL" Style="{StaticResource DataLabelText}"/>
                        <TextBlock x:Name="MemValue" Style="{StaticResource BigNumberText}" FontSize="24" Text="--" Margin="0,2,0,0"/>
                        <TextBlock x:Name="MemSub" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="The standby list is cached data Windows will hand to any process that asks, so it is not wasted memory and purging it is not routine maintenance. It is worth doing in one case: reclaiming a large cache footprint left by something else, right before launching a game."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PurgeBtn" Content="Purge Standby List" Style="{StaticResource FlatButtonStyle}" Click="PurgeBtn_Click"/>
                            <TextBlock x:Name="MemResult" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="WINDOWS GAMING" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <ItemsControl x:Name="GamingList"/>
                        <TextBlock x:Name="GamingResult" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="These are the same settings Windows exposes in Settings > Gaming and Display > Graphics, written to the documented registry values. A toggle showing no state means Windows has never been given a value for it, which is not the same as it being off. Each change is read back afterwards, so a value blocked by policy reports as refused rather than appearing to apply."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="PROCESSES" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="FOREGROUND APP" Style="{StaticResource DataLabelText}"/>
                        <TextBlock x:Name="ForegroundValue" Style="{StaticResource BigNumberText}" FontSize="22" Text="--" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ForegroundSub" Style="{StaticResource MutedText}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PrioritiseBtn" Content="Prioritise Foreground" Style="{StaticResource FlatButtonStyle}" Click="PrioritiseBtn_Click"/>
                            <Button x:Name="TrimBtn" Content="Trim Background" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="TrimBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ProcessResult" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="Both of these are modest. Windows already schedules well, so raising priority helps mainly when something else is competing hard, and trimming a working set pushes pages onto the standby list rather than truly freeing them. Priority is set to above-normal, never High or RealTime: those starve the audio, input and compositor threads a game depends on. Nothing is suspended or killed."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="SHADER CACHE" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="ON DISK" Style="{StaticResource DataLabelText}"/>
                        <TextBlock x:Name="CacheValue" Style="{StaticResource BigNumberText}" FontSize="24" Text="--" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="CacheList" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="Safe to delete: drivers rebuild these on demand, at the cost of a one-off compile pause next launch. Worth clearing after a driver update, where a stale cache genuinely causes stutter and crashes. Clearing it routinely just means paying the recompile again."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ClearCacheBtn" Content="Clear Shader Caches" Style="{StaticResource FlatButtonStyle}" Click="ClearCacheBtn_Click"/>
                            <Button x:Name="RescanBtn" Content="Rescan" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="RescanBtn_Click"/>
                            <TextBlock x:Name="CacheResult" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="DISK CLEANUP" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,18">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Text="RECLAIMABLE" Style="{StaticResource DataLabelText}"/>
                        <TextBlock x:Name="DiskValue" Style="{StaticResource BigNumberText}" FontSize="24" Text="--" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="DiskList" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" MaxWidth="600" TextWrapping="Wrap"
                                   Text="A fixed list of known-safe locations only: temp folders, crash dumps, the Windows Update cache, Prefetch and Delivery Optimization. Nothing is discovered or pattern-matched, no document folder is ever touched, and only files older than 24 hours are removed so anything currently in use is left alone."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CleanDiskBtn" Content="Clean Up" Style="{StaticResource FlatButtonStyle}" Click="CleanDiskBtn_Click"/>
                            <Button x:Name="RescanDiskBtn" Content="Rescan" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" Click="RescanDiskBtn_Click"/>
                            <TextBlock x:Name="DiskResult" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="WINDOWS POWER PLAN" Style="{StaticResource SubHeadingText}"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10" MaxWidth="600" TextWrapping="Wrap"
                                   Text="The OS-level policy for processor states and idle behaviour. Separate from the BIOS wattage caps on the Tuning tab, which are firmware limits; the two are often confused and they do different things."/>
                        <ItemsControl x:Name="PlanList"/>
                        <TextBlock x:Name="PlanResult" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="CREATE A POWER PLAN" Style="{StaticResource SubHeadingText}" Margin="0,18,0,0"/>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Border Style="{StaticResource CardSheenStyle}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,14" MaxWidth="620" TextWrapping="Wrap"
                                   Text="Makes a new plan from one decision: battery life at the left, performance at the right. Every setting below is derived from that, and the available values come from what Windows reports this machine supports rather than from a fixed table. Your existing plans are never modified -- this only adds new ones."/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource MutedText}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" x:Name="PlanName" Style="{StaticResource NumericTextBoxStyle}"
                                     HorizontalAlignment="Left" Width="320" HorizontalContentAlignment="Left"
                                     Text="My Plan" TextChanged="PlanName_Changed"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Battery" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="PlanBias" Minimum="0" Maximum="100" Value="50"
                                    TickFrequency="25" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                    Margin="12,0" VerticalAlignment="Center" ValueChanged="PlanBias_Changed"/>
                            <TextBlock Grid.Column="2" Text="Performance" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="PlanBiasLabel" Style="{StaticResource MutedText}" FontSize="11.5"
                                   HorizontalAlignment="Center" Margin="0,6,0,14"/>

                        <TextBlock Text="WHAT THIS WILL WRITE" Style="{StaticResource DataLabelText}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="PlanPreview"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="CreatePlanBtn" Content="Create Plan" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CreatePlanBtn_Click"/>
                            <Button x:Name="DeletePlanBtn" Content="Delete This Plan" Style="{StaticResource FlatButtonStyle}"
                                    Margin="8,0,0,0" Click="DeletePlanBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="BuilderResult" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
