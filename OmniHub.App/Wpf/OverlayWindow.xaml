<Window x:Class="OmniHub.App.Wpf.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        Title="OmniHub Overlay">
    <!-- Opacity is set from settings at runtime; the value here is only the designer default.
         Rows are built in code from the user's chosen metric list rather than fixed in XAML,
         because which ones appear is now a setting. -->
    <Border x:Name="Card" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="12,9" Opacity="0.88">
        <StackPanel MinWidth="128">
            <TextBlock x:Name="SourceLabel" Style="{StaticResource DataLabelText}" Text="OMNIHUB" Margin="0,0,0,6"/>
            <StackPanel x:Name="MetricRows"/>
            <TextBlock x:Name="StateText" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</Window>
