<Window x:Class="OmniHub.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniHub" Height="740" Width="1100" MinHeight="580" MinWidth="920"
        Icon="/app.ico"
        Background="{StaticResource AppBackgroundGradient}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar. The decorative radial "ambient glow" ellipse that used to sit
             here has been removed: it washed a blue haze across the top-left of
             every screen, which fought the live readouts for attention and was the
             main thing making the window look like a skin rather than a tool. -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="ClassicHeader" DockPanel.Dock="Top" Margin="0,22,0,22">
                    <TextBlock Text="OMNIHUB" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="24,0,0,0"/>
                    <TextBlock x:Name="ModelLabel" Text="" FontFamily="{StaticResource UiFont}" FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}" Margin="24,5,16,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- The console's mark: a pale rounded square with the application's glyph, and the
                     name beside it, as the reference heads its sidebar. -->
                <StackPanel x:Name="ConsoleHeader" DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,0,26" Visibility="Collapsed">
                    <Border Width="32" Height="32" CornerRadius="{DynamicResource RadiusSm}" Background="{StaticResource TextPrimaryBrush}">
                        <Path Data="M8,1.5 L14,5 L14,11 L8,14.5 L2,11 L2,5 Z M2,5 L8,8.5 L14,5 M8,8.5 L8,14.5"
                              Stroke="{StaticResource BackgroundBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Width="17" Height="17" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="ConsoleHeaderName" Text="OmniHub" FontFamily="{StaticResource UiFontSemibold}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="11,0,0,1"/>
                </StackPanel>

                <!-- Empty under the other looks; under Frosted and Dot matrix the floating dock the
                     rail of round buttons sits in (MainWindow.ApplyLook). -->
                <Border x:Name="RailDock" DockPanel.Dock="Top">
                <Grid>
                <!-- One indicator that travels, rather than a rail per item switching on and
                     off. The movement is what makes the sidebar read as a single control:
                     seven independent rails blinking gives no sense of going from one place to
                     another. Sits behind the items so it never intercepts a click. -->
                <Border x:Name="NavIndicator" Width="2.5" Height="22" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Background="{StaticResource AccentBrush}"
                        CornerRadius="0,2,2,0" IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorSlide"/>
                    </Border.RenderTransform>
                </Border>

                <!-- Built in code from the saved workspace layout, not written out here.
                     Seven fixed items were the shape of an application that had decided in
                     advance which screens exist; a list the user can add to, rename and reorder
                     cannot be markup. The leading figure is the number key that switches to it. -->
                <StackPanel x:Name="NavItems"/>
                </Grid>
                </Border>

                <!-- The ACTIVE MODE card that sat here held one fact, the fan mode. Each item above
                     now carries the state of its own subject on a second line, the fan mode among
                     them (NavSummary), so the card said less than the list beside it. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,12">
                    <Button x:Name="EditLayoutBtn" Content="EDIT LAYOUT" Height="36"
                            Style="{StaticResource FlatButtonStyle}" Click="EditLayoutBtn_Click"/>

                    <!-- The console's foot, where the reference keeps a user card: this machine, and
                         who is steering its fans. -->
                    <Border x:Name="ConsoleFooter" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,9"
                            Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="{DynamicResource RadiusSm}"
                                    Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                                <Path Data="M2,3 H14 V10.5 H2 Z M5.5,13.5 H10.5 M8,10.5 V13.5" Stroke="{StaticResource BackgroundBrush}"
                                      StrokeThickness="1.4" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FooterMachine" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse x:Name="FooterDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="FooterStatus" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content.
             Two rows rather than one. An interface variation that does not use the left rail has
             to put its navigation somewhere, and the top row is where: the cockpit band and its
             tab strip, the editorial outline, the command bar all live there. Collapsed and zero
             height under the sidebar interface, which is unchanged. -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopChromeRow" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="TopChrome" Grid.Row="0" Focusable="False" Visibility="Collapsed"/>

            <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ViewSlideTransform"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Activity ribbon: a 2px band along the top edge whose highlight sweeps left
                 to right. It sits near-invisible at rest and brightens for a moment whenever
                 something actually happens, so the window feels alive without anything
                 moving behind the data. Deliberately an edge rather than an animated
                 background: a moving field behind live numbers competes with the numbers,
                 and in this UI the readings are supposed to win. The stops are
                 transparent-accent-transparent, so what travels is a highlight, not a wash. -->
            <Border x:Name="ActivityRibbon" Grid.Row="0" Grid.RowSpan="2" Height="3" VerticalAlignment="Top"
                    IsHitTestVisible="False" Opacity="0.3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.32,0" SpreadMethod="Repeat">
                        <LinearGradientBrush.Transform>
                            <TranslateTransform x:Name="RibbonSlide" X="0"/>
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="#00000000" Offset="0"/>
                        <!-- Recoloured from the live temperature, so the one moving element
                             on screen also reports thermal state instead of just decorating. -->
                        <GradientStop x:Name="RibbonStop" Color="{DynamicResource AccentColor}" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Grid>
</Window>
