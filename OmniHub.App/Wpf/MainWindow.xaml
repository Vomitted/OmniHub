<Window x:Class="OmniHub.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniHub" Height="740" Width="1100" MinHeight="580" MinWidth="920"
        Icon="/app.ico"
        Background="{StaticResource AppBackgroundGradient}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar. The decorative radial "ambient glow" ellipse that used to sit
             here has been removed: it washed a blue haze across the top-left of
             every screen, which fought the live readouts for attention and was the
             main thing making the window look like a skin rather than a tool. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,22,0,22">
                    <TextBlock Text="OMNIHUB" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="24,0,0,0"/>
                    <TextBlock x:Name="ModelLabel" Text="" FontFamily="{StaticResource UiFont}" FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}" Margin="24,5,16,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top">
                <!-- One indicator that travels, rather than a rail per item switching on and
                     off. The movement is what makes the sidebar read as a single control:
                     seven independent rails blinking gives no sense of going from one place to
                     another. Sits behind the items so it never intercepts a click. -->
                <Border x:Name="NavIndicator" Width="2.5" Height="22" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Background="{StaticResource AccentBrush}"
                        CornerRadius="0,2,2,0" IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorSlide"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel x:Name="NavItems">
                    <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavChecked" Tag="dashboard" AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Rectangle Canvas.Left="9" Canvas.Top="1" Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                            </Canvas>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFans" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="fans" AutomationProperties.Name="Fans">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Line X1="8" Y1="6" X2="8" Y2="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="10" Y1="9" X2="14" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="6" Y1="9" X2="2" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Fans" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- Performance: CPU tuning and GPU power, the two halves of one decision
                         about how much this machine is allowed to draw. -->
                    <RadioButton x:Name="NavPerformance" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="performance" AutomationProperties.Name="Performance">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Line X1="3" Y1="2" X2="3" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="1" Canvas.Top="9" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Line X1="8" Y1="2" X2="8" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="6" Canvas.Top="4" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Line X1="13" Y1="2" X2="13" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="7" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                            <TextBlock Text="Performance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPower" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="power" AutomationProperties.Name="Battery">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Rectangle Canvas.Left="1" Canvas.Top="4" Width="11" Height="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" RadiusX="1" RadiusY="1"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="6.5" Width="2.5" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                            <TextBlock Text="Battery" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- System: the Windows-side settings, app GPU routing among them. -->
                    <RadioButton x:Name="NavSystem" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="system" AutomationProperties.Name="System">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Line X1="2" Y1="13" X2="6" Y2="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="6" Y1="9" X2="9" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="9" Y1="11" X2="13" Y2="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Ellipse Canvas.Left="11.5" Canvas.Top="1.5" Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                            <TextBlock Text="System" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDiagnostics" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="diagnostics" AutomationProperties.Name="Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <!-- A trace rising off a baseline: this tab is where the machine gets
                                 measured rather than adjusted. -->
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Line X1="1" Y1="14" X2="15" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Line X1="2" Y1="11" X2="6" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="6" Y1="11" X2="9" Y2="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="9" Y1="4" X2="12" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Line X1="12" Y1="8" X2="15" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="NavChecked" Tag="settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16" Margin="0,0,10,0">
                                <Line X1="1" Y1="4" X2="15" Y2="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="2" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="6" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Line X1="1" Y1="12" X2="15" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="7" Canvas.Top="10" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </Grid>

                <!-- Active mode readout. Left accent rail instead of a gradient outline:
                     it matches the selected nav item's rail, so the sidebar reads as one
                     system rather than two unrelated highlight treatments. -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,14,18" CornerRadius="4"
                        Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Border Width="2.5" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Margin="13,11,12,11">
                            <TextBlock Text="ACTIVE MODE" Style="{StaticResource SubHeadingText}" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ActiveModeLabel" Text="Auto (Curve)" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <ContentControl x:Name="ViewHost" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ViewSlideTransform"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Activity ribbon: a 2px band along the top edge whose highlight sweeps left
                 to right. It sits near-invisible at rest and brightens for a moment whenever
                 something actually happens, so the window feels alive without anything
                 moving behind the data. Deliberately an edge rather than an animated
                 background: a moving field behind live numbers competes with the numbers,
                 and in this UI the readings are supposed to win. The stops are
                 transparent-accent-transparent, so what travels is a highlight, not a wash. -->
            <Border x:Name="ActivityRibbon" Height="3" VerticalAlignment="Top"
                    IsHitTestVisible="False" Opacity="0.3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.32,0" SpreadMethod="Repeat">
                        <LinearGradientBrush.Transform>
                            <TranslateTransform x:Name="RibbonSlide" X="0"/>
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="#00000000" Offset="0"/>
                        <!-- Recoloured from the live temperature, so the one moving element
                             on screen also reports thermal state instead of just decorating. -->
                        <GradientStop x:Name="RibbonStop" Color="{DynamicResource AccentColor}" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Grid>
</Window>
