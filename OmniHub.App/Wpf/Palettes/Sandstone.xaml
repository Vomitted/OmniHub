<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- SANDSTONE. Warm grey with a tan-to-gold ramp. The softest corners and the most air of any theme here. -->

    <Color x:Key="BackgroundColor">#FF12100E</Color>
    <Color x:Key="PanelColor">#FF1A1714</Color>
    <Color x:Key="PanelAltColor">#FF221E1A</Color>
    <Color x:Key="PanelHoverColor">#FF2A2521</Color>
    <Color x:Key="BorderColor">#FF302A25</Color>
    <Color x:Key="BorderStrongColor">#FF433A32</Color>

    <Color x:Key="TextPrimaryColor">#FFEFE8DF</Color>
    <Color x:Key="TextMutedColor">#FFA1968A</Color>
    <Color x:Key="TextFaintColor">#FF6E655C</Color>

    <Color x:Key="AccentColor">#FFD4A373</Color>
    <Color x:Key="AccentColor2">#FFE9C46A</Color>
    <Color x:Key="AccentDimColor">#38D4A373</Color>
    <Color x:Key="AccentSoftColor">#1ED4A373</Color>

    <Color x:Key="GoodColor">#FF8AB17D</Color>
    <Color x:Key="WarnColor">#FFE9C46A</Color>
    <Color x:Key="DangerColor">#FFE07A5F</Color>

    <Color x:Key="MetricCpuColor">#FFD4A373</Color>
    <Color x:Key="MetricMemColor">#FF8AB17D</Color>
    <Color x:Key="MetricGpuColor">#FFE9C46A</Color>

    <Color x:Key="CardTopHighlightColor">#1CFFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1E1A17</Color>

    <Color x:Key="CaptionColor">#FF12100E</Color>
    <Color x:Key="CaptionTextColor">#FFEFE8DF</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>
    <!-- Character beyond colour and shape. The heaviest tracks and the largest figures of any theme, with the strongest lift.

         HeadingFont is a real face rather than an alias, because a palette is merged ahead of
         Theme.xaml and cannot reliably point at a key defined there. -->
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Segoe UI</FontFamily>
    <sys:Double x:Key="TrackHeight">8</sys:Double>
    <sys:Double x:Key="MetricValueSize">34</sys:Double>

</ResourceDictionary>
