<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- EMBER. Warm near-black with the website's heat orange running into amber.

         Note the trade-off this palette has always carried: a warm accent sits close to the
         amber warning colour, so WarnColor is pushed towards yellow and DangerColor towards a
         true red, keeping the thermal scale separable from the chrome that surrounds it. -->

    <Color x:Key="BackgroundColor">#FF0F0C0A</Color>
    <Color x:Key="PanelColor">#FF171310</Color>
    <Color x:Key="PanelAltColor">#FF1E1815</Color>
    <Color x:Key="PanelHoverColor">#FF251E1A</Color>
    <Color x:Key="BorderColor">#FF2A231E</Color>
    <Color x:Key="BorderStrongColor">#FF3A312A</Color>

    <Color x:Key="TextPrimaryColor">#FFF0EAE4</Color>
    <Color x:Key="TextMutedColor">#FF9C9189</Color>
    <Color x:Key="TextFaintColor">#FF675F59</Color>

    <Color x:Key="AccentColor">#FFE0511E</Color>
    <Color x:Key="AccentColor2">#FFF59E0B</Color>
    <Color x:Key="AccentDimColor">#38E0511E</Color>
    <Color x:Key="AccentSoftColor">#1EE0511E</Color>

    <Color x:Key="GoodColor">#FF57C48A</Color>
    <Color x:Key="WarnColor">#FFF2D24A</Color>
    <Color x:Key="DangerColor">#FFE8453A</Color>

    <Color x:Key="MetricCpuColor">#FFE0511E</Color>
    <Color x:Key="MetricMemColor">#FF57C48A</Color>
    <Color x:Key="MetricGpuColor">#FFF59E0B</Color>

    <Color x:Key="CardTopHighlightColor">#16FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1F1A17</Color>

    <Color x:Key="CaptionColor">#FF0F0C0A</Color>
    <Color x:Key="CaptionTextColor">#FFF0EAE4</Color>

</ResourceDictionary>
