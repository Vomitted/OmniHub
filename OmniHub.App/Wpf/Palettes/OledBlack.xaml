<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OLED BLACK. True #000000 ground, so the pixels are actually off.

         Same blue-into-cyan accent as Midnight; only the surfaces change. The panels sit a
         little closer to black than Midnight's and carry less blue, because a tinted panel
         against a true-black ground shows its hue much more strongly than it does against a
         tinted one. -->

    <Color x:Key="BackgroundColor">#FF000000</Color>
    <Color x:Key="PanelColor">#FF0B0E12</Color>
    <Color x:Key="PanelAltColor">#FF11151A</Color>
    <Color x:Key="PanelHoverColor">#FF161B21</Color>
    <Color x:Key="BorderColor">#FF1A1F26</Color>
    <Color x:Key="BorderStrongColor">#FF232A33</Color>

    <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="TextMutedColor">#FF8B949E</Color>
    <Color x:Key="TextFaintColor">#FF5C6570</Color>

    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentColor2">#FF22D3EE</Color>
    <Color x:Key="AccentDimColor">#383B82F6</Color>
    <Color x:Key="AccentSoftColor">#1E3B82F6</Color>

    <Color x:Key="GoodColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <Color x:Key="MetricCpuColor">#FF3B82F6</Color>
    <Color x:Key="MetricMemColor">#FF22C55E</Color>
    <Color x:Key="MetricGpuColor">#FF22D3EE</Color>

    <Color x:Key="CardTopHighlightColor">#12FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF13171C</Color>

    <Color x:Key="CaptionColor">#FF000000</Color>
    <Color x:Key="CaptionTextColor">#FFE6EDF3</Color>

</ResourceDictionary>
