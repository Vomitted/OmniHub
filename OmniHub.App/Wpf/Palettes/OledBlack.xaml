<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OLED BLACK. True #000000 so the pixels are off, and deliberately the tightest theme here: sharp corners and close padding, an instrument rather than a card deck. -->

    <Color x:Key="BackgroundColor">#FF000000</Color>
    <Color x:Key="PanelColor">#FF0A0C0E</Color>
    <Color x:Key="PanelAltColor">#FF101316</Color>
    <Color x:Key="PanelHoverColor">#FF15191D</Color>
    <Color x:Key="BorderColor">#FF191D21</Color>
    <Color x:Key="BorderStrongColor">#FF23282D</Color>

    <Color x:Key="TextPrimaryColor">#FFE8EDF0</Color>
    <Color x:Key="TextMutedColor">#FF8A9299</Color>
    <Color x:Key="TextFaintColor">#FF5A6167</Color>

    <Color x:Key="AccentColor">#FF22D3EE</Color>
    <Color x:Key="AccentColor2">#FF2DD4BF</Color>
    <Color x:Key="AccentDimColor">#3822D3EE</Color>
    <Color x:Key="AccentSoftColor">#1E22D3EE</Color>

    <Color x:Key="GoodColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <Color x:Key="MetricCpuColor">#FF22D3EE</Color>
    <Color x:Key="MetricMemColor">#FF22C55E</Color>
    <Color x:Key="MetricGpuColor">#FF2DD4BF</Color>

    <Color x:Key="CardTopHighlightColor">#10FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF101316</Color>

    <Color x:Key="CaptionColor">#FF000000</Color>
    <Color x:Key="CaptionTextColor">#FFE8EDF0</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <Thickness x:Key="CardPadding">12</Thickness>

</ResourceDictionary>
