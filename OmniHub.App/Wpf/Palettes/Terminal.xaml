<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TERMINAL. Green phosphor on near-black, square corners, minimum padding. The densest theme here on purpose: it is meant to read like a console, not an app. -->

    <Color x:Key="BackgroundColor">#FF060806</Color>
    <Color x:Key="PanelColor">#FF0C100C</Color>
    <Color x:Key="PanelAltColor">#FF121712</Color>
    <Color x:Key="PanelHoverColor">#FF171D17</Color>
    <Color x:Key="BorderColor">#FF1B221B</Color>
    <Color x:Key="BorderStrongColor">#FF2A342A</Color>

    <Color x:Key="TextPrimaryColor">#FFD7E6D7</Color>
    <Color x:Key="TextMutedColor">#FF86998A</Color>
    <Color x:Key="TextFaintColor">#FF5A6B5D</Color>

    <Color x:Key="AccentColor">#FF3FB950</Color>
    <Color x:Key="AccentColor2">#FF7EE787</Color>
    <Color x:Key="AccentDimColor">#383FB950</Color>
    <Color x:Key="AccentSoftColor">#1E3FB950</Color>

    <Color x:Key="GoodColor">#FF3FB950</Color>
    <Color x:Key="WarnColor">#FFD29922</Color>
    <Color x:Key="DangerColor">#FFF85149</Color>

    <Color x:Key="MetricCpuColor">#FF3FB950</Color>
    <Color x:Key="MetricMemColor">#FF3FB950</Color>
    <Color x:Key="MetricGpuColor">#FF7EE787</Color>

    <Color x:Key="CardTopHighlightColor">#0EFFFFFF</Color>
    <Color x:Key="GridLineColor">#FF111611</Color>

    <Color x:Key="CaptionColor">#FF060806</Color>
    <Color x:Key="CaptionTextColor">#FFD7E6D7</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>
    <CornerRadius x:Key="RadiusMd">3</CornerRadius>
    <Thickness x:Key="CardPadding">10</Thickness>

</ResourceDictionary>
