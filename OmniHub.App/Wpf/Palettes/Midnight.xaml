<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MIDNIGHT. The reference palette. Blue-tinted near-black, rounded, roomy. -->

    <Color x:Key="BackgroundColor">#FF0A0D12</Color>
    <Color x:Key="PanelColor">#FF11151B</Color>
    <Color x:Key="PanelAltColor">#FF161B22</Color>
    <Color x:Key="PanelHoverColor">#FF1A2028</Color>
    <Color x:Key="BorderColor">#FF1E242C</Color>
    <Color x:Key="BorderStrongColor">#FF262D36</Color>

    <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
    <Color x:Key="TextMutedColor">#FF8B949E</Color>
    <Color x:Key="TextFaintColor">#FF5C6570</Color>

    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentColor2">#FF22D3EE</Color>
    <Color x:Key="AccentDimColor">#383B82F6</Color>
    <Color x:Key="AccentSoftColor">#1E3B82F6</Color>

    <Color x:Key="GoodColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <Color x:Key="MetricCpuColor">#FF3B82F6</Color>
    <Color x:Key="MetricMemColor">#FF22C55E</Color>
    <Color x:Key="MetricGpuColor">#FF22D3EE</Color>

    <Color x:Key="CardTopHighlightColor">#14FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF171C22</Color>

    <Color x:Key="CaptionColor">#FF0A0D12</Color>
    <Color x:Key="CaptionTextColor">#FFE6EDF3</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>

</ResourceDictionary>
