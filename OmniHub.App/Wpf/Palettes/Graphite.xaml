<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GRAPHITE. Neutral grey, and the one palette whose accent is deliberately not a colour.

         The premise: on this theme the only chromatic thing on screen should be a reading.
         The accent ramp is steel rather than blue, so a progress track still reads as a track
         and the application mark still has a gradient, but nothing in the chrome competes with
         a temperature going amber. -->

    <Color x:Key="BackgroundColor">#FF0E0E0E</Color>
    <Color x:Key="PanelColor">#FF151515</Color>
    <Color x:Key="PanelAltColor">#FF1B1B1B</Color>
    <Color x:Key="PanelHoverColor">#FF212121</Color>
    <Color x:Key="BorderColor">#FF262626</Color>
    <Color x:Key="BorderStrongColor">#FF333333</Color>

    <Color x:Key="TextPrimaryColor">#FFEDEDED</Color>
    <Color x:Key="TextMutedColor">#FF9A9A9A</Color>
    <Color x:Key="TextFaintColor">#FF636363</Color>

    <Color x:Key="AccentColor">#FF7D8894</Color>
    <Color x:Key="AccentColor2">#FFA9B4C0</Color>
    <Color x:Key="AccentDimColor">#387D8894</Color>
    <Color x:Key="AccentSoftColor">#1E7D8894</Color>

    <Color x:Key="GoodColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <Color x:Key="MetricCpuColor">#FF7D8894</Color>
    <Color x:Key="MetricMemColor">#FF22C55E</Color>
    <Color x:Key="MetricGpuColor">#FFA9B4C0</Color>

    <Color x:Key="CardTopHighlightColor">#14FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1D1D1D</Color>

    <Color x:Key="CaptionColor">#FF0E0E0E</Color>
    <Color x:Key="CaptionTextColor">#FFEDEDED</Color>

</ResourceDictionary>
