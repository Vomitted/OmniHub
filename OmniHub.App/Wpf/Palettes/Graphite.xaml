<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- GRAPHITE. Neutral grey with a steel ramp, so the only chromatic thing on screen is a reading. Middling shape, generous air. -->

    <Color x:Key="BackgroundColor">#FF0E0E0E</Color>
    <Color x:Key="PanelColor">#FF151515</Color>
    <Color x:Key="PanelAltColor">#FF1B1B1B</Color>
    <Color x:Key="PanelHoverColor">#FF212121</Color>
    <Color x:Key="BorderColor">#FF262626</Color>
    <Color x:Key="BorderStrongColor">#FF333333</Color>

    <Color x:Key="TextPrimaryColor">#FFEDEDED</Color>
    <Color x:Key="TextMutedColor">#FF9A9A9A</Color>
    <Color x:Key="TextFaintColor">#FF636363</Color>

    <Color x:Key="AccentColor">#FF7D8894</Color>
    <Color x:Key="AccentColor2">#FFA9B4C0</Color>
    <Color x:Key="AccentDimColor">#387D8894</Color>
    <Color x:Key="AccentSoftColor">#1E7D8894</Color>

    <Color x:Key="GoodColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>

    <Color x:Key="MetricCpuColor">#FF7D8894</Color>
    <Color x:Key="MetricMemColor">#FF22C55E</Color>
    <Color x:Key="MetricGpuColor">#FFA9B4C0</Color>

    <Color x:Key="CardTopHighlightColor">#14FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1D1D1D</Color>

    <Color x:Key="CaptionColor">#FF0E0E0E</Color>
    <Color x:Key="CaptionTextColor">#FFEDEDED</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <!-- Character beyond colour and shape. Deliberately unremarkable: this theme's whole argument is that nothing in the chrome should draw the eye.

         HeadingFont is a real face rather than an alias, because a palette is merged ahead of
         Theme.xaml and cannot reliably point at a key defined there. -->
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Segoe UI</FontFamily>
    <sys:Double x:Key="TrackHeight">5</sys:Double>
    <sys:Double x:Key="MetricValueSize">30</sys:Double>

</ResourceDictionary>
