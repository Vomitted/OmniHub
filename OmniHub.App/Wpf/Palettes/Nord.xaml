<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NORD. Cool desaturated slate with a frost accent. The calmest palette here, and the airiest. -->

    <Color x:Key="BackgroundColor">#FF0E1319</Color>
    <Color x:Key="PanelColor">#FF161C24</Color>
    <Color x:Key="PanelAltColor">#FF1D242E</Color>
    <Color x:Key="PanelHoverColor">#FF232B36</Color>
    <Color x:Key="BorderColor">#FF2A3341</Color>
    <Color x:Key="BorderStrongColor">#FF3B4757</Color>

    <Color x:Key="TextPrimaryColor">#FFE5E9F0</Color>
    <Color x:Key="TextMutedColor">#FF9AA5B4</Color>
    <Color x:Key="TextFaintColor">#FF6B7688</Color>

    <Color x:Key="AccentColor">#FF88C0D0</Color>
    <Color x:Key="AccentColor2">#FF8FBCBB</Color>
    <Color x:Key="AccentDimColor">#3888C0D0</Color>
    <Color x:Key="AccentSoftColor">#1E88C0D0</Color>

    <Color x:Key="GoodColor">#FFA3BE8C</Color>
    <Color x:Key="WarnColor">#FFEBCB8B</Color>
    <Color x:Key="DangerColor">#FFBF616A</Color>

    <Color x:Key="MetricCpuColor">#FF88C0D0</Color>
    <Color x:Key="MetricMemColor">#FFA3BE8C</Color>
    <Color x:Key="MetricGpuColor">#FF8FBCBB</Color>

    <Color x:Key="CardTopHighlightColor">#14FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1A212A</Color>

    <Color x:Key="CaptionColor">#FF0E1319</Color>
    <Color x:Key="CaptionTextColor">#FFE5E9F0</Color>

    <!-- Shape and density. These are what stop a theme being a recolour: a palette sets how
         sharp the corners are and how much air a card carries, so switching theme changes the
         feel of the layout and not only its hue. -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>

</ResourceDictionary>
